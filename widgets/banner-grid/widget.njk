{% set layout = widget.data.layout | default('2') %}
{% set gap = widget.data.gap | default('4') %}
{% set blocks = widget.blocks | default([]) %}

{% if blocks.length > 0 %}

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">

    <div class="grid grid-cols-1 gap-{{ gap }}
      {% if layout == '2' %} md:grid-cols-2
      {% elif layout == '3' %} md:grid-cols-3
      {% else %} md:grid-cols-4
      {% endif %}">

      {% for block in blocks %}
        {% set overlay = block.settings.overlay_opacity | default(30) %}

        <a href="{{ block.settings.link | default('#') }}"
           class="group relative block aspect-[3/2] rounded-xl overflow-hidden">

          {# Banner Image #}
          {% if block.settings.image %}
            <img src="{{ block.settings.image.fileUrl }}" alt="{{ block.settings.title }}"
                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
          {% else %}
            <div class="w-full h-full bg-gradient-to-br from-primary/20 to-secondary/20"></div>
          {% endif %}

          {# Overlay #}
          <div class="absolute inset-0 bg-black transition-opacity duration-300 group-hover:opacity-[{{ (overlay + 10) / 100 }}]"
               style="opacity: {{ overlay / 100 }};"></div>

          {# Content #}
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4 z-10">
            {% if block.settings.title %}
              <h3 class="text-white text-lg md:text-xl lg:text-2xl font-bold mb-2 transition-transform duration-300 group-hover:-translate-y-1">
                {{ block.settings.title }}
              </h3>
            {% endif %}
            {% if block.settings.subtitle %}
              <p class="text-white/80 text-sm md:text-base transition-transform duration-300 group-hover:-translate-y-1">
                {{ block.settings.subtitle }}
              </p>
            {% endif %}
          </div>

        </a>
      {% endfor %}

    </div>

  </div>
</section>
{% else %}
  {# Preview / Empty State #}
  <section class="py-12 md:py-16">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 gap-{{ gap }}
        {% if layout == '2' %} md:grid-cols-2
        {% elif layout == '3' %} md:grid-cols-3
        {% else %} md:grid-cols-4
        {% endif %}">
        {% for i in range(0, layout | int) %}
          <div class="relative aspect-[3/2] rounded-xl overflow-hidden border border-dashed border-theme-border bg-surface">
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
              <svg class="w-12 h-12 text-gray-200 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <div class="h-5 w-32 bg-surface rounded-full mb-2"></div>
              <div class="h-3.5 w-24 bg-surface/60 rounded-full"></div>
            </div>
          </div>
        {% endfor %}
      </div>
      <p class="text-center text-sm text-theme-text-secondary/70 mt-8">{{t('banner.add_banners_hint')}}</p>
    </div>
  </section>
{% endif %}
