<div x-data="{ visible: true }"
     x-show="visible"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100 max-h-12"
     x-transition:leave-end="opacity-0 max-h-0"
     class="overflow-hidden"
     style="background-color: {{ widget.data.background_color | default('#9C27B0') }}; color: {{ widget.data.text_color | default('#FFFFFF') }};">
  <div class="container mx-auto px-4 py-2 flex items-center justify-center relative text-sm">
    {% if widget.data.link %}
      <a href="{{ widget.data.link }}" class="hover:underline">
        {{ widget.data.text }}
      </a>
    {% else %}
      <span>{{ widget.data.text }}</span>
    {% endif %}

    {% if widget.data.show_close %}
      <button @click="visible = false"
              class="absolute end-4 top-1/2 -translate-y-1/2 p-0.5 hover:opacity-70 transition-opacity">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    {% endif %}
  </div>
</div>
