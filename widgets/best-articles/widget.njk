

{% set articles = widget.data.articles | default([]) %}
{% set columns = widget.data.columns | default('3') %}
{% set show_date = widget.data.show_date if widget.data.show_date is defined else true %}
{% set show_excerpt = widget.data.show_excerpt if widget.data.show_excerpt is defined else true %}
{% set hasArticles = articles and articles.length %}

<section class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    {# Section Header #}
    {% if widget.data.title or widget.data.subtitle %}
      <div class="text-center mb-10">
        {% if widget.data.title %}
          <h2 class="text-2xl md:text-3xl font-bold text-theme-text mb-3">{{ widget.data.title }}</h2>
        {% endif %}
        {% if widget.data.subtitle %}
          <p class="text-theme-text-secondary text-sm md:text-base max-w-xl mx-auto">{{ widget.data.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if hasArticles %}

      {% if widget.data.layout == 'slider' %}
        {# Slider Layout #}
        <div class="swiper" x-data x-init="$nextTick(() => {
          var slideCount = $el.querySelectorAll('.swiper-slide').length;
          new Swiper($el, {
            slidesPerView: 1,
            spaceBetween: 24,
            loop: slideCount > {{ columns }},
            pagination: {
              el: $el.querySelector('.swiper-pagination'),
              clickable: true
            },
            breakpoints: {
              640: { slidesPerView: 2 },
              1024: { slidesPerView: {{ columns }} }
            }
          });
        })">
          <div class="swiper-wrapper">
            {% for article in articles %}
              <div class="swiper-slide">
                <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group h-full flex flex-col">
                  {% if article.image and article.image.fileUrl %}
                    <a href="/article/{{ article.handle }}" class="block aspect-[16/10] overflow-hidden relative">
                      <img src="{{ article.image.fileUrl }}"
                           alt="{{ article.title }}"
                           class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                           loading="lazy">
                    </a>
                  {% endif %}
                  <div class="p-5 flex flex-col flex-1">
                    {% if show_date and article.createdAt %}
                      <div class="flex items-center gap-2 mb-2 text-xs text-theme-text-secondary/70">
                        <time class="flex items-center gap-1" x-data x-init="$el.querySelector('span').textContent = new Date('{{ article.createdAt }}').toLocaleDateString('{{ localization.language }}', { year: 'numeric', month: 'short', day: 'numeric' })">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                          </svg>
                          <span></span>
                        </time>
                      </div>
                    {% endif %}
                    <h3 class="text-base font-bold text-theme-text mb-2 group-hover:text-primary transition-colors line-clamp-2">
                      <a href="/article/{{ article.handle }}">{{ article.title }}</a>
                    </h3>
                    {% if show_excerpt and article.description %}
                      <p class="text-sm text-theme-text-secondary leading-relaxed line-clamp-3 mb-4">{{ article.description | striptags | truncate(130, true, '...') }}</p>
                    {% endif %}
                    <a href="/article/{{ article.handle }}"
                       class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-dark transition-colors mt-auto">
                      {{t('blog.read_more')}}
                      <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                      </svg>
                    </a>
                  </div>
                </article>
              </div>
            {% endfor %}
          </div>
          <div class="swiper-pagination mt-6"></div>
        </div>

      {% else %}
        {# Grid Layout #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ columns }} gap-6">
          {% for article in articles %}
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col">
              {% if article.image and article.image.fileUrl %}
                <a href="/article/{{ article.handle }}" class="block aspect-[16/10] overflow-hidden relative">
                  <img src="{{ article.image.fileUrl }}"
                       alt="{{ article.title }}"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                       loading="lazy">
                </a>
              {% endif %}
              <div class="p-5 flex flex-col flex-1">
                {% if show_date and article.createdAt %}
                  <div class="flex items-center gap-2 mb-2 text-xs text-theme-text-secondary/70">
                    <time class="flex items-center gap-1" x-data x-init="$el.querySelector('span').textContent = new Date('{{ article.createdAt }}').toLocaleDateString('{{ localization.language }}', { year: 'numeric', month: 'short', day: 'numeric' })">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                      </svg>
                      <span></span>
                    </time>
                  </div>
                {% endif %}
                <h3 class="text-base font-bold text-theme-text mb-2 group-hover:text-primary transition-colors line-clamp-2">
                  <a href="/article/{{ article.handle }}">{{ article.title }}</a>
                </h3>
                {% if show_excerpt and article.description %}
                  <p class="text-sm text-theme-text-secondary leading-relaxed line-clamp-3 mb-4">{{ article.description | striptags | truncate(130, true, '...') }}</p>
                {% endif %}
                <a href="/article/{{ article.handle }}"
                   class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-dark transition-colors mt-auto">
                  {{t('blog.read_more')}}
                  <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                  </svg>
                </a>
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}

    {% else %}
      {# Preview / Empty State #}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ columns }} gap-6">
        {% for i in range(0, columns | int) %}
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-dashed border-theme-border">
            <div class="aspect-[16/10] bg-surface flex items-center justify-center relative">
              <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6V7.5z"/>
              </svg>
              {% if loop.first %}
                <span class="absolute top-3 start-3 bg-white/80 text-gray-400 text-xs font-bold px-3 py-1 rounded-full">{{t('blog.category')}}</span>
              {% endif %}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <div class="h-3 w-24 bg-surface rounded-full"></div>
              </div>
              <div class="space-y-2 mb-3">
                <div class="h-4 bg-surface rounded-full w-full"></div>
                <div class="h-4 bg-surface rounded-full w-3/4"></div>
              </div>
              <div class="space-y-1.5 mb-4">
                <div class="h-3 bg-surface rounded-full w-full"></div>
                <div class="h-3 bg-surface rounded-full w-full"></div>
                <div class="h-3 bg-surface rounded-full w-2/3"></div>
              </div>
              <div class="h-3 w-20 bg-primary/10 rounded-full"></div>
            </div>
          </div>
        {% endfor %}
      </div>
      <p class="text-center text-sm text-theme-text-secondary/70 mt-6">{{t('blog.select_articles_hint')}}</p>
    {% endif %}
  </div>
</section>
