{% set use_theme = widget.data.use_theme_color if widget.data.use_theme_color is defined else true %}
{% set bg_color = 'var(--color-primary)' if use_theme else (widget.data.background_color | default('var(--color-primary)')) %}

<section class="py-12 md:py-16 relative overflow-hidden"
  {% if widget.data.background_style == 'solid' %}
    style="background-color: {{ bg_color }};"
  {% elif widget.data.background_style == 'image' and widget.data.background_image %}
    style="background-image: url('{{ widget.data.background_image.fileUrl }}'); background-size: cover; background-position: center;"
  {% else %}
    style="background: linear-gradient(135deg, {{ bg_color }}, var(--color-primary-dark));"
  {% endif %}
>
  {# Overlay for image background #}
  {% if widget.data.background_style == 'image' and widget.data.background_image %}
    <div class="absolute inset-0 bg-black/50"></div>
  {% endif %}

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-2xl mx-auto text-center" x-data="{ email: '', submitted: false, loading: false }">

      {# Success State #}
      <div x-show="submitted" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" x-cloak>
        <div class="py-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-white/20 flex items-center justify-center">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
          </div>
          <p class="text-white text-lg font-bold">{{ widget.data.success_message | default('شكراً لاشتراكك!') }}</p>
        </div>
      </div>

      {# Form State #}
      <div x-show="!submitted">
        {# Title #}
        {% if widget.data.title %}
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{{ widget.data.title }}</h2>
        {% endif %}

        {# Subtitle #}
        {% if widget.data.subtitle %}
          <p class="text-white/80 text-sm md:text-base mb-8">{{ widget.data.subtitle }}</p>
        {% endif %}

        {# Form #}
        <form @submit.prevent="loading = true; setTimeout(() => { submitted = true; loading = false; }, 1000);"
              class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto">
          <input type="email"
                 x-model="email"
                 required
                 placeholder="{{ widget.data.placeholder | default('أدخلي بريدك الإلكتروني') }}"
                 class="flex-1 px-5 py-3 rounded-full bg-white/20 border border-white/30 text-white placeholder-white/60 focus:outline-none focus:bg-white/30 focus:border-white/50 backdrop-blur-sm transition-all text-sm">
          <button type="submit"
                  :disabled="loading"
                  class="px-8 py-3 rounded-full bg-white text-primary font-bold text-sm hover:bg-surface transition-colors disabled:opacity-70 flex items-center justify-center gap-2 whitespace-nowrap">
            <span x-show="!loading">{{ widget.data.button_text | default('اشتراك') }}</span>
            <span x-show="loading" x-cloak>
              <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </span>
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
