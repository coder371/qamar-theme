<section id="{{ widget.id }}" class="py-8 md:py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    {# Page Cover Image #}
    {% if context.page.cover %}
      <div class="mb-8 rounded-xl overflow-hidden">
        <img src="{{ context.page.cover }}" alt="{{ context.page.title }}" class="w-full h-64 md:h-80 object-cover">
      </div>
    {% endif %}

    {# Page Title #}
    <h1 class="text-2xl md:text-3xl font-bold text-theme-text mb-8 pb-4 border-b border-theme-border">
      {{ context.page.title }}
    </h1>

    {# Page Content #}
    {% if context.page.content %}
      <div class="prose prose-lg max-w-none text-theme-text
        [&_h2]:text-xl [&_h2]:md:text-2xl [&_h2]:font-bold [&_h2]:text-theme-text [&_h2]:mt-8 [&_h2]:mb-4
        [&_h3]:text-lg [&_h3]:md:text-xl [&_h3]:font-semibold [&_h3]:text-theme-text [&_h3]:mt-6 [&_h3]:mb-3
        [&_p]:text-theme-text-secondary [&_p]:leading-relaxed [&_p]:mb-4
        [&_ul]:my-4 [&_ul]:space-y-2 [&_ul]:list-disc [&_ul]:ps-6
        [&_ol]:my-4 [&_ol]:space-y-2 [&_ol]:list-decimal [&_ol]:ps-6
        [&_li]:text-theme-text-secondary [&_li]:leading-relaxed
        [&_strong]:text-theme-text [&_strong]:font-semibold
        [&_a]:text-primary [&_a]:underline [&_a]:hover:text-primary-dark
        [&_blockquote]:border-s-4 [&_blockquote]:border-primary [&_blockquote]:ps-4 [&_blockquote]:italic [&_blockquote]:text-theme-text-secondary [&_blockquote]:my-4
        [&_img]:rounded-lg [&_img]:my-4
        [&_table]:w-full [&_table]:my-4 [&_table]:border-collapse
        [&_th]:bg-surface [&_th]:border [&_th]:border-theme-border [&_th]:px-4 [&_th]:py-2 [&_th]:text-start [&_th]:font-semibold
        [&_td]:border [&_td]:border-theme-border [&_td]:px-4 [&_td]:py-2
      ">
        {{ context.page.content | safe }}
      </div>
    {% endif %}

  </div>
</section>
