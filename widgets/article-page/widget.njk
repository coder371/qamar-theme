{% set article = context.article %}
{% set show_date = widget.data.show_date if widget.data.show_date is defined else true %}
{% set show_share = widget.data.show_share if widget.data.show_share is defined else true %}
{% set show_views = widget.data.show_views if widget.data.show_views is defined else true %}
{% set show_image = widget.data.show_image if widget.data.show_image is defined else true %}
{% set show_tags = widget.data.show_tags if widget.data.show_tags is defined else true %}

{% if article %}
<section class="py-8 md:py-12">
  <div class="container mx-auto px-4">

    {# Breadcrumb #}
    <nav class="mb-6 md:mb-8" aria-label="breadcrumb">
      <ol class="flex items-center gap-1.5 text-xs md:text-sm text-theme-text-secondary/70">
        <li><a href="/" class="hover:text-primary transition-colors">{{t('common.home')}}</a></li>
        <li>
          <svg class="w-3 h-3 rtl:rotate-180 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        <li><a href="/blog" class="hover:text-primary transition-colors">{{t('blog.blog')}}</a></li>
        {% if article.category and article.category.title %}
          <li>
            <svg class="w-3 h-3 rtl:rotate-180 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </li>
          <li><a href="/blog/{{ article.category.handle }}" class="hover:text-primary transition-colors">{{ article.category.title }}</a></li>
        {% endif %}
        <li>
          <svg class="w-3 h-3 rtl:rotate-180 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </li>
        <li class="text-theme-text-secondary font-medium line-clamp-1">{{ article.title }}</li>
      </ol>
    </nav>

    <article class="max-w-3xl mx-auto">

      {# Article Header #}
      <header class="mb-8">
        <h1 class="text-2xl md:text-4xl font-bold text-theme-text leading-tight mb-4">{{ article.title }}</h1>

        {# Meta Info #}
        <div class="flex flex-wrap items-center gap-4 text-sm text-theme-text-secondary/70">
          {% if article.category and article.category.title %}
            <a href="/blog/{{ article.category.handle }}" class="inline-block bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full hover:bg-primary/20 transition-colors">
              {{ article.category.title }}
            </a>
          {% endif %}
          {% if show_date and article.createdAt %}
            <time class="flex items-center gap-1.5" x-data x-init="$el.querySelector('span').textContent = new Date('{{ article.createdAt }}').toLocaleDateString('{{ localization.language }}', { year: 'numeric', month: 'long', day: 'numeric' })">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
              </svg>
              <span></span>
            </time>
          {% endif %}
          {% if show_views and article.views %}
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.007-9.963-7.178z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {{ article.views }} {{t('blog.views')}}
            </span>
          {% endif %}
        </div>
      </header>

      {# Featured Image #}
      {% if show_image and article.image and article.image.fileUrl %}
        <div class="mb-8 rounded-2xl overflow-hidden">
          <img src="{{ article.image.fileUrl }}"
               alt="{{ article.title }}"
               class="w-full h-auto object-cover max-h-[500px]">
        </div>
      {% endif %}

      {# Article Content #}
      <div class="prose prose-lg max-w-none
                  prose-headings:text-theme-text prose-headings:font-bold
                  prose-h2:text-xl prose-h2:md:text-2xl prose-h2:mt-10 prose-h2:mb-4
                  prose-h3:text-lg prose-h3:md:text-xl prose-h3:mt-8 prose-h3:mb-3
                  prose-p:text-theme-text-secondary prose-p:leading-relaxed prose-p:mb-4
                  prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                  prose-strong:text-theme-text
                  prose-ul:my-4 prose-ol:my-4
                  prose-li:text-theme-text-secondary prose-li:leading-relaxed
                  prose-img:rounded-xl prose-img:my-6
                  prose-blockquote:border-primary prose-blockquote:text-theme-text-secondary">
        {{ article.content | safe }}
      </div>

      {# Tags #}
      {% if show_tags and article.tags and article.tags.length %}
        <div class="mt-8 pt-6 border-t border-theme-border/40">
          <div class="flex flex-wrap items-center gap-2">
            <svg class="w-4 h-4 text-theme-text-secondary/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/>
            </svg>
            {% for tag in article.tags %}
              <span class="inline-block bg-surface text-theme-text-secondary text-xs font-medium px-3 py-1.5 rounded-full">
                {{ tag }}
              </span>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {# Share Buttons #}
      {% if show_share %}
        <div class="mt-8 pt-6 border-t border-theme-border/40">
          <p class="text-sm font-bold text-theme-text mb-3">{{t('blog.share_article')}}</p>
          <div class="flex items-center gap-3" x-data="{ url: window.location.href, title: '{{ article.title | replace("'", "\\'") }}' }">
            {# Twitter/X #}
            <a :href="'https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(url)"
               target="_blank" rel="noopener"
               class="w-10 h-10 rounded-full bg-surface hover:bg-theme-border/30 flex items-center justify-center text-theme-text-secondary hover:text-theme-text transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            {# WhatsApp #}
            <a :href="'https://wa.me/?text=' + encodeURIComponent(title + ' ' + url)"
               target="_blank" rel="noopener"
               class="w-10 h-10 rounded-full bg-surface hover:bg-green-50 flex items-center justify-center text-theme-text-secondary hover:text-green-600 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            {# Copy Link #}
            <button @click="navigator.clipboard.writeText(url); $el.classList.add('!bg-green-50', '!text-green-600'); setTimeout(() => $el.classList.remove('!bg-green-50', '!text-green-600'), 2000)"
                    class="w-10 h-10 rounded-full bg-surface hover:bg-theme-border/30 flex items-center justify-center text-theme-text-secondary hover:text-theme-text transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-3.061a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 00-6.364 6.364L4.343 8.28"/>
              </svg>
            </button>
          </div>
        </div>
      {% endif %}

    </article>

    {# Related Articles #}
    {% set related = context.related_articles | default([]) %}
    {% if related and related.length %}
      <div class="mt-16 max-w-5xl mx-auto">
        <h2 class="text-xl md:text-2xl font-bold text-theme-text mb-8 text-center">{{t('blog.related_articles')}}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for article in related %}
            <article class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col">
              {% if article.image and article.image.fileUrl %}
                <a href="/article/{{ article.handle }}" class="block aspect-[16/10] overflow-hidden">
                  <img src="{{ article.image.fileUrl }}"
                       alt="{{ article.title }}"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                       loading="lazy">
                </a>
              {% endif %}
              <div class="p-5 flex flex-col flex-1">
                {% if article.createdAt %}
                  <div class="flex items-center gap-2 mb-2 text-xs text-theme-text-secondary/70">
                    <time class="flex items-center gap-1" x-data x-init="$el.querySelector('span').textContent = new Date('{{ article.createdAt }}').toLocaleDateString('{{ localization.language }}', { year: 'numeric', month: 'short', day: 'numeric' })">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                      </svg>
                      <span></span>
                    </time>
                  </div>
                {% endif %}
                <h3 class="text-base font-bold text-theme-text mb-2 group-hover:text-primary transition-colors line-clamp-2">
                  <a href="/article/{{ article.handle }}">{{ article.title }}</a>
                </h3>
                {% if article.description %}
                  <p class="text-sm text-theme-text-secondary leading-relaxed line-clamp-3 mb-4">{{ article.description | striptags | truncate(130, true, '...') }}</p>
                {% endif %}
                <a href="/article/{{ article.handle }}"
                   class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-dark transition-colors mt-auto">
                  {{t('blog.read_more')}}
                  <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
                  </svg>
                </a>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% else %}
  {# Preview / Empty State #}
  <section class="py-8 md:py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-2 mb-8">
          <div class="h-3 w-16 bg-gray-100 rounded-full"></div>
          <div class="h-3 w-3 bg-gray-100 rounded-full"></div>
          <div class="h-3 w-20 bg-gray-100 rounded-full"></div>
          <div class="h-3 w-3 bg-gray-100 rounded-full"></div>
          <div class="h-3 w-32 bg-gray-100 rounded-full"></div>
        </div>
        <div class="space-y-3 mb-4">
          <div class="h-8 bg-gray-100 rounded-full w-full"></div>
          <div class="h-8 bg-gray-100 rounded-full w-2/3"></div>
        </div>
        <div class="flex gap-4 mb-8">
          <div class="h-4 w-28 bg-gray-50 rounded-full"></div>
          <div class="h-4 w-20 bg-gray-50 rounded-full"></div>
        </div>
        <div class="aspect-[16/9] bg-gray-100 rounded-2xl flex items-center justify-center mb-8 border border-dashed border-gray-200">
          <svg class="w-16 h-16 text-gray-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6V7.5z"/>
          </svg>
        </div>
        <div class="space-y-3">
          {% for i in range(0, 8) %}
            <div class="h-4 bg-gray-50 rounded-full {% if loop.last %}w-1/2{% elif loop.index % 3 == 0 %}w-5/6{% else %}w-full{% endif %}"></div>
          {% endfor %}
          <div class="h-6 mt-6"></div>
          {% for i in range(0, 5) %}
            <div class="h-4 bg-gray-50 rounded-full {% if loop.last %}w-2/3{% elif loop.index % 4 == 0 %}w-4/5{% else %}w-full{% endif %}"></div>
          {% endfor %}
        </div>
        <p class="text-center text-sm text-gray-400 mt-10">{{t('blog.article_preview_hint')}}</p>
      </div>
    </div>
  </section>
{% endif %}
