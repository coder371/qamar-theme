{% set use_theme = widget.data.use_theme_color if widget.data.use_theme_color is defined else true %}
{% set bg_color = 'var(--color-primary)' if use_theme else (widget.data.background_color | default('var(--color-primary)')) %}
{% set text_color = widget.data.text_color | default('white') %}
{% set height = widget.data.height | default('medium') %}
{% set alignment = widget.data.text_alignment | default('center') %}
{% set overlay_opacity = widget.data.overlay_opacity | default(70) %}
{% set button_style = widget.data.button_style | default('filled') %}
{% set is_full_width = widget.data.full_width | default(false) %}

<section class="relative overflow-hidden
  {% if height == 'small' %} py-12
  {% elif height == 'large' %} py-28
  {% else %} py-20
  {% endif %}"
  {% if not widget.data.image %}
    style="background-color: {{ bg_color }};"
  {% endif %}>

  {# Background Image #}
  {% if widget.data.image %}
    <img src="{{ widget.data.image.fileUrl }}" alt="{{ widget.data.title }}"
         class="absolute inset-0 w-full h-full object-cover" loading="lazy">
    <div class="absolute inset-0" style="background-color: {{ bg_color }}; opacity: {{ overlay_opacity / 100 }};"></div>
  {% endif %}

  {# Content #}
  <div class="{% if not is_full_width %}container mx-auto{% endif %} px-4 relative z-10
    {% if alignment == 'center' %} text-center
    {% elif alignment == 'start' %} text-start
    {% else %} text-end
    {% endif %}">
    <div class="{% if alignment == 'center' %}max-w-3xl mx-auto{% else %}max-w-3xl{% endif %}">

      {# Badge #}
      {% if widget.data.badge_text %}
        <span class="inline-block px-4 py-1.5 rounded-full text-sm font-semibold mb-4
          {% if text_color == 'white' %}
            bg-white/20 text-white border border-white/30
          {% else %}
            bg-theme-text/10 text-theme-text border border-theme-text/20
          {% endif %}">
          {{ widget.data.badge_text }}
        </span>
      {% endif %}

      {% if widget.data.title %}
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4
          {% if text_color == 'white' %} text-white {% else %} text-theme-text {% endif %}">
          {{ widget.data.title }}
        </h2>
      {% endif %}

      {% if widget.data.subtitle %}
        <p class="text-lg md:text-xl mb-8 opacity-90
          {% if text_color == 'white' %} text-white {% else %} text-theme-text-secondary {% endif %}">
          {{ widget.data.subtitle | safe }}
        </p>
      {% endif %}

      {# Countdown Timer #}
      {% if widget.data.show_countdown and widget.data.countdown_date %}
        <div x-data="{
               days: 0, hours: 0, minutes: 0, seconds: 0,
               expired: false, interval: null,
               targetDate: '{{ widget.data.countdown_date }}',
               init() {
                 this.update();
                 this.interval = setInterval(() => this.update(), 1000);
               },
               update() {
                 const now = new Date().getTime();
                 const target = new Date(this.targetDate).getTime();
                 const diff = target - now;
                 if (diff <= 0) {
                   this.expired = true;
                   this.days = 0; this.hours = 0; this.minutes = 0; this.seconds = 0;
                   if (this.interval) clearInterval(this.interval);
                   return;
                 }
                 this.days = Math.floor(diff / (1000 * 60 * 60 * 24));
                 this.hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                 this.minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                 this.seconds = Math.floor((diff % (1000 * 60)) / 1000);
               },
               destroy() {
                 if (this.interval) clearInterval(this.interval);
               }
             }"
             x-init="init()"
             class="flex items-center {% if alignment == 'center' %}justify-center{% elif alignment == 'start' %}justify-start{% else %}justify-end{% endif %} gap-3 md:gap-5 mb-8">

          <template x-if="!expired">
            <div class="flex items-center gap-3 md:gap-5">
              {# Days #}
              <div class="flex flex-col items-center">
                <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl flex items-center justify-center text-2xl md:text-3xl font-bold
                  {% if text_color == 'white' %} bg-white/20 text-white {% else %} bg-theme-text/10 text-theme-text {% endif %}">
                  <span x-text="String(days).padStart(2, '0')">00</span>
                </div>
                <span class="text-xs md:text-sm mt-2 opacity-80
                  {% if text_color == 'white' %} text-white {% else %} text-theme-text-secondary {% endif %}">
                  {{t('promo.days')}}
                </span>
              </div>

              <span class="text-2xl font-bold opacity-60
                {% if text_color == 'white' %} text-white {% else %} text-theme-text {% endif %}">:</span>

              {# Hours #}
              <div class="flex flex-col items-center">
                <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl flex items-center justify-center text-2xl md:text-3xl font-bold
                  {% if text_color == 'white' %} bg-white/20 text-white {% else %} bg-theme-text/10 text-theme-text {% endif %}">
                  <span x-text="String(hours).padStart(2, '0')">00</span>
                </div>
                <span class="text-xs md:text-sm mt-2 opacity-80
                  {% if text_color == 'white' %} text-white {% else %} text-theme-text-secondary {% endif %}">
                  {{t('promo.hours')}}
                </span>
              </div>

              <span class="text-2xl font-bold opacity-60
                {% if text_color == 'white' %} text-white {% else %} text-theme-text {% endif %}">:</span>

              {# Minutes #}
              <div class="flex flex-col items-center">
                <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl flex items-center justify-center text-2xl md:text-3xl font-bold
                  {% if text_color == 'white' %} bg-white/20 text-white {% else %} bg-theme-text/10 text-theme-text {% endif %}">
                  <span x-text="String(minutes).padStart(2, '0')">00</span>
                </div>
                <span class="text-xs md:text-sm mt-2 opacity-80
                  {% if text_color == 'white' %} text-white {% else %} text-theme-text-secondary {% endif %}">
                  {{t('promo.minutes')}}
                </span>
              </div>

              <span class="text-2xl font-bold opacity-60
                {% if text_color == 'white' %} text-white {% else %} text-theme-text {% endif %}">:</span>

              {# Seconds #}
              <div class="flex flex-col items-center">
                <div class="w-16 h-16 md:w-20 md:h-20 rounded-xl flex items-center justify-center text-2xl md:text-3xl font-bold
                  {% if text_color == 'white' %} bg-white/20 text-white {% else %} bg-theme-text/10 text-theme-text {% endif %}">
                  <span x-text="String(seconds).padStart(2, '0')">00</span>
                </div>
                <span class="text-xs md:text-sm mt-2 opacity-80
                  {% if text_color == 'white' %} text-white {% else %} text-theme-text-secondary {% endif %}">
                  {{t('promo.seconds')}}
                </span>
              </div>
            </div>
          </template>

          <template x-if="expired">
            <p class="text-xl md:text-2xl font-bold
              {% if text_color == 'white' %} text-white {% else %} text-theme-text {% endif %}">
              {{t('promo.expired')}}
            </p>
          </template>
        </div>

      {% endif %}

      {# CTA Button #}
      {% if widget.data.button_text %}
        <a href="{{ widget.data.button_link | default('/products') }}"
           class="inline-block px-8 py-3 rounded-full font-semibold text-lg transition-all duration-300 hover:scale-105 hover:shadow-lg
           {% if button_style == 'outline' %}
             {% if text_color == 'white' %}
               bg-transparent text-white border-2 border-white hover:bg-white hover:text-theme-text
             {% else %}
               bg-transparent border-2 hover:text-white
             {% endif %}
           {% else %}
             {% if text_color == 'white' %}
               bg-white hover:bg-surface
             {% else %}
               text-white hover:opacity-90
             {% endif %}
           {% endif %}"
           {% if button_style == 'outline' and text_color == 'dark' %}
             style="border-color: {{ bg_color }}; color: {{ bg_color }};"
             onmouseover="this.style.backgroundColor='{{ bg_color }}';this.style.color='#fff'"
             onmouseout="this.style.backgroundColor='transparent';this.style.color='{{ bg_color }}'"
           {% elif button_style == 'filled' and text_color == 'white' %}
             style="color: {{ bg_color }};"
           {% elif button_style == 'filled' and text_color == 'dark' %}
             style="background-color: {{ bg_color }};"
           {% endif %}>
          {{ widget.data.button_text }}
        </a>
      {% endif %}

    </div>
  </div>

</section>
