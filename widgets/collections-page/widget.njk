{# Collections Page Widget - Qamar Theme #}
{% set collections = context.collections | default([]) %}
{% set pagination = context.pagination %}
{% set layout = widget.data.layout | default('card') %}
{% set columns = widget.data.columns | default('3') %}
{% set showCount = widget.data.show_count | default(true) %}

<section class="py-6 md:py-10">
  <div class="container mx-auto px-4">

    {# ===== Breadcrumb ===== #}
    <nav class="mb-5 md:mb-6" aria-label="breadcrumb">
      <ol class="flex items-center gap-1.5 text-xs md:text-sm text-theme-text-secondary/70">
        <li><a href="/" class="hover:text-primary transition-colors">{{t('common.home')}}</a></li>
        <li><svg class="w-3 h-3 rtl:rotate-180 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
        <li class="text-theme-text-secondary font-medium">{{t('common.categories')}}</li>
      </ol>
    </nav>

    {# ===== Header ===== #}
    <div class="mb-8 md:mb-10">
      {% if widget.data.title %}
        <h1 class="text-2xl md:text-3xl font-bold text-theme-text">{{ widget.data.title }}</h1>
      {% endif %}
      {% if widget.data.subtitle %}
        <p class="text-theme-text-secondary mt-2">{{ widget.data.subtitle }}</p>
      {% endif %}
      {% if pagination %}
        <p class="text-sm text-theme-text-secondary/70 mt-2">{{ pagination.totalItems }} {{t('common.categories')}}</p>
      {% endif %}
    </div>

    {# ===== Collections Grid ===== #}
    {% if collections | length > 0 %}
      <div class="grid grid-cols-2 gap-3 md:gap-5
        {% if columns == '2' %} md:grid-cols-2
        {% elif columns == '4' %} md:grid-cols-4
        {% else %} md:grid-cols-3
        {% endif %}">

        {% for collection in collections %}

          {# ---- Card Layout ---- #}
          {% if layout == 'card' %}
            <a href="/collections/{{ collection.handle }}"
               class="group block bg-white rounded-2xl overflow-hidden border border-theme-border/40 hover:shadow-lg hover:border-theme-border transition-all duration-300">
              <div class="aspect-[4/3] overflow-hidden bg-surface relative">
                {% if collection.image %}
                  <img src="{{ collection.image.fileUrl }}"
                       alt="{{ collection.title }}"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                       loading="lazy">
                {% else %}
                  <div class="w-full h-full bg-gradient-to-br from-primary/5 to-primary/10 flex items-center justify-center">
                    <svg class="w-12 h-12 text-primary/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <div class="p-3.5 md:p-4">
                <h3 class="font-semibold text-theme-text group-hover:text-primary transition-colors text-sm md:text-base">
                  {{ collection.title }}
                </h3>
                {% if showCount and collection.productCount %}
                  <p class="text-xs text-theme-text-secondary/70 mt-1">{{ collection.productCount }} {{t('common.products')}}</p>
                {% endif %}
              </div>
            </a>

          {# ---- Overlay Layout ---- #}
          {% elif layout == 'overlay' %}
            <a href="/collections/{{ collection.handle }}"
               class="group block rounded-2xl overflow-hidden relative aspect-square">
              {% if collection.image %}
                <img src="{{ collection.image.fileUrl }}"
                     alt="{{ collection.title }}"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                     loading="lazy">
              {% else %}
                <div class="w-full h-full bg-gradient-to-br from-primary/10 to-primary/20"></div>
              {% endif %}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-4 md:p-5">
                <h3 class="text-white font-bold text-base md:text-lg">{{ collection.title }}</h3>
                {% if showCount and collection.productCount %}
                  <p class="text-white/70 text-xs mt-1">{{ collection.productCount }} {{t('common.products')}}</p>
                {% endif %}
              </div>
            </a>

          {# ---- Minimal Layout ---- #}
          {% elif layout == 'minimal' %}
            <a href="/collections/{{ collection.handle }}"
               class="group block text-center">
              <div class="aspect-square rounded-full overflow-hidden mx-auto mb-3 w-full max-w-[200px] border-2 border-theme-border/40 group-hover:border-primary transition-all duration-300 shadow-sm group-hover:shadow-md">
                {% if collection.image %}
                  <img src="{{ collection.image.fileUrl }}"
                       alt="{{ collection.title }}"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                       loading="lazy">
                {% else %}
                  <div class="w-full h-full bg-gradient-to-br from-primary/5 to-primary/10 flex items-center justify-center">
                    <svg class="w-10 h-10 text-primary/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <h3 class="font-semibold text-theme-text group-hover:text-primary transition-colors text-sm md:text-base">
                {{ collection.title }}
              </h3>
              {% if showCount and collection.productCount %}
                <p class="text-xs text-theme-text-secondary/70 mt-0.5">{{ collection.productCount }} {{t('common.products')}}</p>
              {% endif %}
            </a>
          {% endif %}

        {% endfor %}
      </div>

      {# ===== Pagination ===== #}
      {% if pagination and pagination.totalPages > 1 %}
        <nav class="flex items-center justify-center gap-1.5 mt-10" aria-label="pagination">
          {# Previous #}
          {% if pagination.currentPage > 1 %}
            <a href="?page={{ pagination.currentPage - 1 }}"
               class="w-10 h-10 rounded-xl flex items-center justify-center text-theme-text-secondary hover:bg-surface hover:text-primary transition-colors">
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </a>
          {% else %}
            <span class="w-10 h-10 rounded-xl flex items-center justify-center text-gray-200">
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </span>
          {% endif %}

          {# Page Numbers #}
          {% for i in range(1, pagination.totalPages + 1) %}
            {% if i == pagination.currentPage %}
              <span class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary text-white font-semibold text-sm">{{ i }}</span>
            {% elif i == 1 or i == pagination.totalPages or (i >= pagination.currentPage - 1 and i <= pagination.currentPage + 1) %}
              <a href="?page={{ i }}"
                 class="w-10 h-10 rounded-xl flex items-center justify-center text-theme-text-secondary hover:bg-surface hover:text-primary transition-colors text-sm font-medium">{{ i }}</a>
            {% elif i == pagination.currentPage - 2 or i == pagination.currentPage + 2 %}
              <span class="w-6 flex items-center justify-center text-gray-300 text-sm">...</span>
            {% endif %}
          {% endfor %}

          {# Next #}
          {% if pagination.hasNextPage %}
            <a href="?page={{ pagination.currentPage + 1 }}"
               class="w-10 h-10 rounded-xl flex items-center justify-center text-theme-text-secondary hover:bg-surface hover:text-primary transition-colors">
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          {% else %}
            <span class="w-10 h-10 rounded-xl flex items-center justify-center text-gray-200">
              <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          {% endif %}
        </nav>
      {% endif %}

    {% else %}
      {# ===== Preview / Empty State ===== #}
      <div class="grid grid-cols-2 gap-3 md:gap-5
        {% if columns == '2' %} md:grid-cols-2
        {% elif columns == '4' %} md:grid-cols-4
        {% else %} md:grid-cols-3
        {% endif %}">
        {% for i in range(0, columns | int * 2) %}
          {% if layout == 'card' %}
            <div class="bg-white rounded-2xl overflow-hidden border border-dashed border-theme-border">
              <div class="aspect-[4/3] bg-surface flex items-center justify-center">
                <svg class="w-12 h-12 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div class="p-3.5 md:p-4">
                <div class="h-4 w-24 bg-surface rounded-full mb-1.5"></div>
                <div class="h-3 w-16 bg-surface/60 rounded-full"></div>
              </div>
            </div>
          {% elif layout == 'overlay' %}
            <div class="rounded-2xl overflow-hidden aspect-square border border-dashed border-theme-border bg-surface relative">
              <svg class="w-12 h-12 text-gray-200 absolute top-1/2 start-1/2 -translate-x-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <div class="absolute inset-0 bg-black/10 flex flex-col justify-end p-4">
                <div class="h-5 w-28 bg-white/30 rounded-full mb-1"></div>
                <div class="h-3 w-16 bg-white/20 rounded-full"></div>
              </div>
            </div>
          {% elif layout == 'minimal' %}
            <div class="text-center">
              <div class="aspect-square rounded-full overflow-hidden mx-auto mb-3 w-full max-w-[200px] border-2 border-dashed border-theme-border bg-surface flex items-center justify-center">
                <svg class="w-10 h-10 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div class="h-4 w-20 bg-surface rounded-full mx-auto mb-1"></div>
              <div class="h-3 w-14 bg-surface/60 rounded-full mx-auto"></div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <p class="text-center text-sm text-theme-text-secondary/70 mt-8">{{t('collection.collections_page_hint')}}</p>
    {% endif %}
  </div>
</section>
