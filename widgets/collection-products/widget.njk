{# Widget settings #}
{% set columns_desktop = widget.data.columns_desktop | default('4') %}
{% set columns_mobile = widget.data.columns_mobile | default('2') %}
{% set show_sort = widget.data.show_sort | default(true) %}
{% set show_filters = widget.data.show_filters if widget.data.show_filters is defined else true %}
{% set pagination_type = widget.data.pagination_type | default('pagination') %}

{# Card display settings #}
{% set _cs_rating = widget.data.card_show_rating if widget.data.card_show_rating is defined else true %}
{% set _cs_options = widget.data.card_show_options if widget.data.card_show_options is defined else true %}
{% set _cs_badge = widget.data.card_show_badge if widget.data.card_show_badge is defined else true %}
{% set _cs_button = widget.data.card_show_button if widget.data.card_show_button is defined else true %}
{% set _cs_compare = widget.data.card_show_compare_price if widget.data.card_show_compare_price is defined else true %}
{% set _cs_wishlist = widget.data.card_show_wishlist | default(false) %}
{% set _cs_ratio = widget.data.card_image_ratio | default('square') %}
{% set _cs_lines = widget.data.card_title_lines | default('2') %}
{% set _cs_fit = widget.data.card_image_fit | default('contain') %}
{% set _cs_hover = widget.data.card_hover_effect | default('zoom') %}
{% set _cs_radius = widget.data.card_border_radius | default('lg') %}

{% if collection %}
{% set filters = collection.filters | default([]) %}
{% set hasFilters = show_filters and filters | length > 0 %}
{% set hasSidebar = show_sort or hasFilters %}
<section class="py-8 md:py-12" x-data="filterPage({
  cardSettings: {
    showRating: {{ _cs_rating }},
    showOptions: {{ _cs_options }},
    showBadge: {{ _cs_badge }},
    imageRatio: '{{ _cs_ratio }}',
    showButton: {{ _cs_button }},
    showComparePrice: {{ _cs_compare }},
    titleLines: '{{ _cs_lines }}',
    imageFit: '{{ _cs_fit }}',
    hoverEffect: '{{ _cs_hover }}',
    showWishlist: {{ _cs_wishlist }},
    borderRadius: '{{ _cs_radius }}',
    gridClass: '{% if hasSidebar %}md:grid-cols-2 lg:grid-cols-3{% elif columns_desktop == "3" %}md:grid-cols-3{% else %}md:grid-cols-4{% endif %}'
  },
  translations: {
    addToCart: '{{ t("product.add_to_cart_f") if settings.addressingTone == "feminine" else t("product.add_to_cart") }}',
    chooseOptions: '{{ t("product.choose_options_f") if settings.addressingTone == "feminine" else t("product.choose_options") }}',
    outOfStock: '{{t("product.out_of_stock")}}',
    added: '{{t("product.added")}}',
    noProducts: '{{t("collection.no_products")}}',
    noResults: '{{t("common.no_results")}}',
    home: '{{t("common.home")}}',
    products: '{{t("common.products")}}'
  }
})">
  <div class="container mx-auto px-4">
    <div class="{% if hasSidebar %}flex gap-8{% endif %}">

      {# ===== Desktop Sidebar ===== #}
      {% if hasSidebar %}
        <aside class="hidden md:block w-64 shrink-0">
          <div class="sticky bottom-6 space-y-5">
            {# Products Count #}
            <div id="products-count" class="bg-white rounded-2xl border border-theme-border/40 p-5">
              <p class="text-sm text-theme-text-secondary">
                <span class="font-bold text-theme-text">{{ collection.products | length }}</span>
                {{t('common.products')}}
              </p>
              <template x-if="activeCount > 0">
                <button @click="clearFilters()"
                        class="mt-2 text-xs text-red-500 hover:text-red-600 font-medium transition-colors">
                  {{t('collection.clear_filters')}}
                </button>
              </template>
            </div>

            {% ui "filter-sidebar.njk", show_sort=show_sort, filters=filters, hasFilters=hasFilters %}
          </div>
        </aside>
      {% endif %}

      {# ===== Products Area ===== #}
      <div class="flex-1 min-w-0">

        {# Mobile Toolbar + Bottom Sheets #}
        {% ui "filter-mobile.njk", show_sort=show_sort, filters=filters, hasFilters=hasFilters, hasSidebar=hasSidebar %}

        {# Products Grid Wrapper (swapped via AJAX) #}
        <div id="products-grid-wrapper" class="relative min-h-[200px]">

          {# Loading Overlay #}
          <div x-show="loading" x-cloak
               class="absolute inset-0 bg-white/70 z-10 flex items-center justify-center rounded-2xl"
               style="backdrop-filter: blur(2px);"
               x-transition:enter="transition ease-out duration-200"
               x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
               x-transition:leave="transition ease-in duration-150"
               x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
            <svg class="w-8 h-8 animate-spin text-primary" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>

          {% if collection.products | length %}
            <div class="grid gap-4 md:gap-6
              {% if columns_mobile == '1' %} grid-cols-1 {% else %} grid-cols-2 {% endif %}
              {% if hasSidebar %}
                md:grid-cols-2 lg:grid-cols-3
              {% else %}
                {% if columns_desktop == '3' %} md:grid-cols-3
                {% else %} md:grid-cols-4
                {% endif %}
              {% endif %}">
              {% for product in collection.products %}
                {% ui "product-card.njk", product=product, show_rating=_cs_rating, show_options=_cs_options, show_badge=_cs_badge, image_ratio=_cs_ratio, show_button=_cs_button, show_compare_price=_cs_compare, title_lines=_cs_lines, image_fit=_cs_fit, hover_effect=_cs_hover, show_wishlist=_cs_wishlist, border_radius=_cs_radius %}
              {% endfor %}
            </div>

            {# Pagination (AJAX) #}
            {% if pagination_type == 'pagination' and collection.pagination %}
              <nav class="flex items-center justify-center gap-2 mt-10" aria-label="pagination">
                {% if collection.pagination.has_prev %}
                  <button @click.prevent="goToPage({{ collection.pagination.current_page - 1 }})"
                     class="flex items-center justify-center w-10 h-10 rounded-lg border border-theme-border hover:border-primary hover:text-primary transition-colors">
                    <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                  </button>
                {% endif %}

                {% for page_num in range(1, collection.pagination.total_pages + 1) %}
                  {% if page_num == collection.pagination.current_page %}
                    <span class="flex items-center justify-center w-10 h-10 rounded-lg bg-primary text-white text-sm font-semibold">{{ page_num }}</span>
                  {% elif page_num == 1 or page_num == collection.pagination.total_pages or (page_num >= collection.pagination.current_page - 1 and page_num <= collection.pagination.current_page + 1) %}
                    <button @click.prevent="goToPage({{ page_num }})"
                       class="flex items-center justify-center w-10 h-10 rounded-lg border border-theme-border text-sm text-theme-text-secondary hover:border-primary hover:text-primary transition-colors">{{ page_num }}</button>
                  {% elif page_num == collection.pagination.current_page - 2 or page_num == collection.pagination.current_page + 2 %}
                    <span class="flex items-center justify-center w-10 h-10 text-theme-text-secondary/70 text-sm">...</span>
                  {% endif %}
                {% endfor %}

                {% if collection.pagination.has_next %}
                  <button @click.prevent="goToPage({{ collection.pagination.current_page + 1 }})"
                     class="flex items-center justify-center w-10 h-10 rounded-lg border border-theme-border hover:border-primary hover:text-primary transition-colors">
                    <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </button>
                {% endif %}
              </nav>
            {% endif %}

            {# Load More (AJAX) #}
            {% if pagination_type == 'load_more' and collection.pagination.has_next %}
              <div class="text-center mt-10">
                <button @click="goToPage({{ collection.pagination.current_page + 1 }})"
                        :disabled="loading"
                        class="inline-flex items-center gap-2 px-8 py-3 border-2 rounded-xl text-sm font-semibold transition-all duration-300 hover:shadow-md border-primary text-primary"
                        :class="loading && 'opacity-50 cursor-not-allowed'">
                  <svg x-show="loading" x-cloak class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span x-text="loading ? '{{t('common.loading')}}' : '{{t('common.load_more')}}'">{{t('common.load_more')}}</span>
                </button>
              </div>
            {% endif %}

          {% else %}
            <div class="text-center py-20">
              <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-surface mb-6">
                <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-theme-text mb-2">{{t('collection.no_products')}}</h3>
              <p class="text-theme-text-secondary text-sm mb-6">{{t('common.no_results')}}</p>
              <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:opacity-80">
                {{t('common.home')}}
                <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          {% endif %}

        </div>
      </div>
    </div>
  </div>
</section>

{% else %}
  {# Preview / Empty State - No collection data #}
  <section class="py-8 md:py-12">
    <div class="container mx-auto px-4">
      <div class="flex gap-8">

        {# ===== Skeleton Sidebar (Desktop) ===== #}
        {% if show_filters or show_sort %}
          <aside class="hidden md:block w-64 shrink-0">
            <div class="space-y-5">
              {# Products Count Skeleton #}
              <div class="bg-white rounded-2xl border border-dashed border-theme-border p-5">
                <div class="flex items-center gap-2">
                  <div class="h-5 w-8 bg-surface rounded-full"></div>
                  <div class="h-4 w-16 bg-surface rounded-full"></div>
                </div>
              </div>

              {# Sort Skeleton #}
              {% if show_sort %}
                <div class="bg-white rounded-2xl border border-dashed border-theme-border p-5">
                  <div class="h-4 w-16 bg-surface rounded-full mb-4"></div>
                  <div class="space-y-2.5">
                    {% for i in range(0, 4) %}
                      <div class="flex items-center gap-2.5">
                        <div class="w-4 h-4 rounded-full border-2 border-theme-border/60 {% if loop.first %}bg-primary/20 border-primary/40{% endif %}"></div>
                        <div class="h-3.5 bg-surface rounded-full {% if loop.first %}w-20{% elif loop.index0 == 1 %}w-28{% elif loop.index0 == 2 %}w-24{% else %}w-16{% endif %}"></div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}

              {# Filter Groups Skeleton #}
              {% if show_filters %}
                {% for i in range(0, 3) %}
                  <div class="bg-white rounded-2xl border border-dashed border-theme-border p-5">
                    <div class="flex items-center justify-between mb-4">
                      <div class="h-4 {% if loop.first %}w-14{% elif loop.index0 == 1 %}w-20{% else %}w-16{% endif %} bg-surface rounded-full"></div>
                      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                    <div class="space-y-2.5">
                      {% for j in range(0, 4) %}
                        <div class="flex items-center gap-2.5">
                          {% if loop.parent.loop.index0 == 2 %}
                            <div class="w-5 h-5 rounded-full bg-surface border border-theme-border/40"></div>
                          {% else %}
                            <div class="w-4 h-4 rounded border-2 border-theme-border/60"></div>
                          {% endif %}
                          <div class="h-3 bg-surface rounded-full {% if loop.first %}w-20{% elif loop.index0 == 1 %}w-16{% elif loop.index0 == 2 %}w-24{% else %}w-14{% endif %}"></div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </aside>
        {% endif %}

        {# ===== Products Area ===== #}
        <div class="flex-1 min-w-0">

          {# Mobile Toolbar Skeleton #}
          {% if show_filters or show_sort %}
            <div class="flex md:hidden items-center gap-3 mb-5">
              {% if show_filters %}
                <div class="flex-1 h-11 rounded-xl border border-dashed border-theme-border bg-white flex items-center justify-center gap-2 px-4">
                  <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                  </svg>
                  <div class="h-3 w-12 bg-surface rounded-full"></div>
                </div>
              {% endif %}
              {% if show_sort %}
                <div class="flex-1 h-11 rounded-xl border border-dashed border-theme-border bg-white flex items-center justify-center gap-2 px-4">
                  <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
                  </svg>
                  <div class="h-3 w-12 bg-surface rounded-full"></div>
                </div>
              {% endif %}
            </div>
          {% endif %}

          {# Skeleton Products Grid #}
          <div class="grid gap-4 md:gap-6
            {% if columns_mobile == '1' %} grid-cols-1 {% else %} grid-cols-2 {% endif %}
            {% if show_filters or show_sort %}
              md:grid-cols-2 lg:grid-cols-3
            {% else %}
              {% if columns_desktop == '3' %} md:grid-cols-3
              {% else %} md:grid-cols-4
              {% endif %}
            {% endif %}">
            {% set preview_count = 3 if (show_filters or show_sort) else (columns_desktop | int) %}
            {% for i in range(0, preview_count * 2) %}
              <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-dashed border-theme-border">
                <div class="aspect-square bg-surface flex items-center justify-center relative">
                  <svg class="w-12 h-12 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  {% if loop.first %}
                    <span class="absolute top-2.5 start-2.5 h-5 w-12 bg-primary/10 rounded-full"></span>
                  {% endif %}
                </div>
                <div class="p-3">
                  <div class="space-y-2 mb-3">
                    <div class="h-3.5 bg-surface rounded-full w-full"></div>
                    <div class="h-3.5 bg-surface rounded-full {% if loop.index0 % 3 == 0 %}w-3/4{% elif loop.index0 % 3 == 1 %}w-2/3{% else %}w-4/5{% endif %}"></div>
                  </div>
                  <div class="flex items-center gap-0.5 mb-3">
                    {% for s in range(5) %}
                      <div class="w-3.5 h-3.5 rounded-sm bg-surface"></div>
                    {% endfor %}
                  </div>
                  <div class="flex items-center gap-2 mb-3">
                    <div class="h-4 w-20 bg-surface rounded-full"></div>
                    {% if loop.index0 % 2 == 0 %}
                      <div class="h-3 w-14 bg-surface/60 rounded-full"></div>
                    {% endif %}
                  </div>
                  <div class="h-10 bg-primary/10 rounded-lg"></div>
                </div>
              </div>
            {% endfor %}
          </div>

          {# Skeleton Pagination #}
          <div class="flex items-center justify-center gap-2 mt-10">
            <div class="w-10 h-10 rounded-lg border border-dashed border-theme-border flex items-center justify-center">
              <svg class="w-4 h-4 text-gray-300 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
            </div>
            <div class="w-10 h-10 rounded-lg bg-primary/15 flex items-center justify-center">
              <div class="h-3.5 w-3 bg-primary/30 rounded"></div>
            </div>
            <div class="w-10 h-10 rounded-lg border border-dashed border-theme-border flex items-center justify-center">
              <div class="h-3.5 w-3 bg-surface rounded"></div>
            </div>
            <div class="w-10 h-10 rounded-lg border border-dashed border-theme-border flex items-center justify-center">
              <div class="h-3.5 w-3 bg-surface rounded"></div>
            </div>
            <div class="w-10 h-10 rounded-lg border border-dashed border-theme-border flex items-center justify-center">
              <svg class="w-4 h-4 text-gray-300 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>

        </div>
      </div>

      <p class="text-center text-sm text-theme-text-secondary/70 mt-8">{{t('collection.select_collection_hint')}}</p>
    </div>
  </section>
{% endif %}
