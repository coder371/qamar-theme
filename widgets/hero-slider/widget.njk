{# Hero Slider Widget - Qamar Theme #}
{% set blocks = widget.blocks | default([]) %}
{% set heightClass = {
  'small': 'h-[400px]',
  'medium': 'h-[500px]',
  'large': 'h-[600px]',
  'full': 'h-screen'
} %}
{% set currentHeight = heightClass[widget.data.height] | default('h-[600px]') %}
{% set isRtl = localization.language != 'en' %}

{% if blocks | length > 0 %}
<section class="hero-slider relative w-full overflow-hidden"
         x-data="{ swiperReady: false }">
  <div class="swiper hero-swiper {{ currentHeight }}"
       x-init="
        $nextTick(() => {
          var slideCount = $el.querySelectorAll('.swiper-slide').length;
          const heroSwiper = new Swiper($el, {
            loop: slideCount > 1,
            speed: 800,
            effect: 'fade',
            fadeEffect: { crossFade: true },
            {% if widget.data.autoplay %}
            autoplay: {
              delay: {{ widget.data.interval | default(5) }} * 1000,
              disableOnInteraction: false,
              pauseOnMouseEnter: true
            },
            {% endif %}
            {% if widget.data.show_dots %}
            pagination: {
              el: $el.querySelector('.hero-pagination'),
              clickable: true,
              bulletClass: 'hero-bullet',
              bulletActiveClass: 'hero-bullet-active'
            },
            {% endif %}
            {% if widget.data.show_arrows %}
            navigation: {
              nextEl: $el.querySelector('.hero-next'),
              prevEl: $el.querySelector('.hero-prev')
            },
            {% endif %}
            dir: '{{ 'rtl' if isRtl else 'ltr' }}'
          });
          swiperReady = true;
        })
       ">

    <div class="swiper-wrapper">
      {% for block in blocks %}
        <div class="swiper-slide {{ currentHeight }} relative overflow-hidden">

          {# Background Image - Desktop #}
          {% if block.settings.image %}
            <img src="{{ block.settings.image.fileUrl }}"
                 alt="{{ block.settings.title }}"
                 class="absolute inset-0 w-full h-full object-cover {% if block.settings.mobile_image %}hidden md:block{% endif %}"
                 loading="{% if loop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}

          {# Background Image - Mobile (if provided) #}
          {% if block.settings.mobile_image %}
            <img src="{{ block.settings.mobile_image.fileUrl }}"
                 alt="{{ block.settings.title }}"
                 class="absolute inset-0 w-full h-full object-cover md:hidden"
                 loading="{% if loop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}

          {# Overlay #}
          <div class="absolute inset-0 bg-black"
               style="opacity: {{ (block.settings.overlay_opacity | default(30)) / 100 }};"></div>

          {# Text Content #}
          <div class="relative z-10 h-full flex items-center">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
              <div class="max-w-2xl {% if block.settings.text_position == 'center' %}mx-auto text-center{% elif block.settings.text_position == 'end' %}ms-auto text-end{% else %}text-start{% endif %}"
                   style="color: {{ block.settings.text_color | default('#FFFFFF') }};">

                {# Title #}
                {% if block.settings.title %}
                  <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight
                             opacity-0 translate-y-6 transition-all duration-700 ease-out"
                      x-bind:class="swiperReady && 'opacity-100 translate-y-0'">
                    {{ block.settings.title }}
                  </h1>
                {% endif %}

                {# Subtitle #}
                {% if block.settings.subtitle %}
                  <p class="text-base sm:text-lg md:text-xl mb-8 leading-relaxed opacity-80
                            opacity-0 translate-y-6 transition-all duration-700 delay-200 ease-out"
                     x-bind:class="swiperReady && 'opacity-100 translate-y-0'">
                    {{ block.settings.subtitle | safe }}
                  </p>
                {% endif %}

                {# CTA Button #}
                {% if block.settings.button_text %}
                  <div class="opacity-0 translate-y-6 transition-all duration-700 delay-[400ms] ease-out"
                       x-bind:class="swiperReady && 'opacity-100 translate-y-0'">
                    <a href="{{ block.settings.button_url | default('/products') }}"
                       class="inline-block bg-primary hover:bg-primary-dark text-white font-medium
                              px-8 py-3 sm:px-10 sm:py-4 rounded-lg text-base sm:text-lg
                              transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5">
                      {{ block.settings.button_text }}
                    </a>
                  </div>
                {% endif %}

              </div>
            </div>
          </div>

        </div>
      {% endfor %}
    </div>

    {# Navigation Arrows #}
    {% if widget.data.show_arrows %}
      <button class="hero-prev absolute top-1/2 -translate-y-1/2 start-3 sm:start-5 z-20
                     w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/20 backdrop-blur-sm
                     flex items-center justify-center text-white
                     hover:bg-white/40 transition-all duration-300
                     opacity-0 group-hover:opacity-100 focus:opacity-100"
              aria-label="{{t('common.back')}}">
        <svg class="w-5 h-5 sm:w-6 sm:h-6 {% if isRtl %}rotate-180{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button class="hero-next absolute top-1/2 -translate-y-1/2 end-3 sm:end-5 z-20
                     w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/20 backdrop-blur-sm
                     flex items-center justify-center text-white
                     hover:bg-white/40 transition-all duration-300
                     opacity-0 group-hover:opacity-100 focus:opacity-100"
              aria-label="{{t('common.continue')}}">
        <svg class="w-5 h-5 sm:w-6 sm:h-6 {% if isRtl %}rotate-180{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    {% endif %}

    {# Pagination Dots #}
    {% if widget.data.show_dots %}
      <div class="hero-pagination absolute bottom-6 start-0 end-0 z-20 flex justify-center gap-2"></div>
    {% endif %}

  </div>

  <style>
    .hero-swiper .swiper-slide {
      opacity: 0 !important;
    }
    .hero-swiper .swiper-slide-active {
      opacity: 1 !important;
    }
    .hero-bullet {
      width: 10px;
      height: 10px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.5);
      cursor: pointer;
      transition: all 0.3s ease;
      display: inline-block;
    }
    .hero-bullet-active {
      background: #ffffff;
      width: 28px;
    }
    .hero-slider:hover .hero-prev,
    .hero-slider:hover .hero-next {
      opacity: 1;
    }
    .hero-swiper .swiper-slide-active h1,
    .hero-swiper .swiper-slide-active p,
    .hero-swiper .swiper-slide-active > div > div > div > div {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
  </style>
</section>
{% endif %}
