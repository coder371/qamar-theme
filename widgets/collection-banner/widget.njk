{% set show_description = widget.data.show_description | default(true) %}
{% set show_breadcrumb = widget.data.show_breadcrumb | default(true) %}
{% set show_count = widget.data.show_count | default(true) %}
{% set height = widget.data.height | default('small') %}
{% set overlay_color = widget.data.overlay_color | default('#1a1a2e') %}
{% set overlay_opacity = widget.data.overlay_opacity | default(50) %}

{% if collection %}
{# Determine background image: widget setting fallback to collection image #}
{% set bg_image = widget.data.background_image.fileUrl | default(collection.image.fileUrl) %}

<section class="relative overflow-hidden
  {% if height == 'small' %} py-10 md:py-14
  {% elif height == 'medium' %} py-16 md:py-24
  {% else %} py-24 md:py-36
  {% endif %}">

  {# Background Image #}
  {% if bg_image %}
    <div class="absolute inset-0">
      <img src="{{ bg_image }}"
           alt="{{ collection.title }}"
           class="w-full h-full object-cover">
    </div>
    {# Overlay #}
    <div class="absolute inset-0" style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity / 100 }};"></div>
  {% else %}
    {# Solid background fallback #}
    <div class="absolute inset-0" style="background-color: {{ overlay_color }};"></div>
  {% endif %}

  {# Content #}
  <div class="container mx-auto px-4 relative z-10">

    {# Breadcrumb #}
    {% if show_breadcrumb %}
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="flex items-center gap-2 text-sm {% if bg_image %}text-white/70{% else %}text-white/70{% endif %}">
          <li>
            <a href="/" class="hover:text-white transition-colors">
              {{t('common.home')}}
            </a>
          </li>
          <li>
            <svg class="w-3.5 h-3.5 rtl:rotate-180 inline-block opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </li>
          <li class="text-white font-medium">
            {{ collection.title }}
          </li>
        </ol>
      </nav>
    {% endif %}

    {# Collection Title #}
    <h1 class="text-2xl md:text-4xl font-bold text-white mb-3">
      {{ collection.title }}
    </h1>

    {# Description #}
    {% if show_description and collection.description %}
      <div class="text-white/80 text-sm md:text-base max-w-2xl mb-4 leading-relaxed line-clamp-3">
        {{ collection.description | safe }}
      </div>
    {% endif %}

    {# Products Count #}
    {% if show_count and collection.products | length %}
      <div class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm rounded-full px-4 py-1.5 text-sm text-white">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
        <span>{{ collection.products | length }} {{t('collection.products | length')}}</span>
      </div>
    {% endif %}

  </div>
</section>

{% else %}
  {# Preview / Empty State #}
  <section class="relative overflow-hidden
    {% if height == 'small' %} py-10 md:py-14
    {% elif height == 'medium' %} py-16 md:py-24
    {% else %} py-24 md:py-36
    {% endif %}"
    style="background-color: {{ overlay_color }};">

    <div class="container mx-auto px-4 relative z-10">
      {# Skeleton Breadcrumb #}
      <div class="flex items-center gap-2 mb-4">
        <div class="h-3.5 w-14 bg-white/20 rounded-full"></div>
        <svg class="w-3 h-3 text-white/30 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <div class="h-3.5 w-24 bg-white/25 rounded-full"></div>
      </div>

      {# Skeleton Title #}
      <div class="h-9 w-64 bg-white/20 rounded-full mb-3"></div>

      {# Skeleton Description #}
      <div class="space-y-2 mb-4 max-w-2xl">
        <div class="h-4 w-full bg-white/10 rounded-full"></div>
        <div class="h-4 w-3/4 bg-white/10 rounded-full"></div>
      </div>

      {# Skeleton Count Badge #}
      <div class="inline-flex items-center gap-2 bg-white/10 rounded-full px-4 py-1.5">
        <div class="w-4 h-4 rounded bg-white/15"></div>
        <div class="h-3.5 w-20 bg-white/15 rounded-full"></div>
      </div>
    </div>

    <p class="absolute bottom-3 start-0 end-0 text-center text-xs text-white/40">{{t('collection.banner_preview_hint')}}</p>
  </section>
{% endif %}
