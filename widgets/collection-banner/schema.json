{
  "name": "بانر التصنيف",
  "settings": {
    "show_description": {
      "type": "boolean",
      "label": "إظهار الوصف",
      "default": true
    },
    "show_breadcrumb": {
      "type": "boolean",
      "label": "إظهار مسار التنقل",
      "default": true
    },
    "show_count": {
      "type": "boolean",
      "label": "إظهار عدد المنتجات",
      "default": true
    },
    "height": {
      "type": "select",
      "label": "ارتفاع البانر",
      "default": "small",
      "options": [
        { "value": "small", "label": "صغير" },
        { "value": "medium", "label": "متوسط" },
        { "value": "large", "label": "كبير" }
      ]
    },
    "background_image": {
      "type": "media",
      "label": "صورة الخلفية (اختياري)"
    },
    "overlay_color": {
      "type": "color",
      "label": "لون طبقة التعتيم",
      "default": "#1a1a2e"
    },
    "overlay_opacity": {
      "type": "range",
      "label": "شفافية التعتيم",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    }
  },
  "presets": [
    {
      "category": "صفحة التصنيف",
      "name": "بانر التصنيف"
    }
  ]
}
