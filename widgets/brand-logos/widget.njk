<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    {# Section Header #}
    {% if widget.data.title %}
      <div class="text-center mb-8">
        <h2 class="text-xl md:text-2xl font-bold text-gray-900">{{ widget.data.title }}</h2>
      </div>
    {% endif %}

    {% set blocks = widget.blocks | default([]) %}
    {% set grayscaleClass = 'grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300' if widget.data.grayscale else '' %}

    {% if widget.data.layout == 'grid' %}
      {# Grid Layout #}
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-6 items-center">
        {% for block in blocks %}
          <a href="{{ block.settings.link | default('#') }}"
             class="flex items-center justify-center p-4 group"
             {% if block.settings.link %}target="_blank" rel="noopener"{% endif %}>
            {% if block.settings.image %}
              <img src="{{ block.settings.image.fileUrl }}"
                   alt="{{ block.settings.name }}"
                   class="max-h-12 w-auto object-contain {{ grayscaleClass }}">
            {% else %}
              <span class="text-sm text-gray-400 font-medium">{{ block.settings.name }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>

    {% else %}
      {# Slider Layout #}
      <div class="swiper" x-data x-init="$nextTick(() => {
        var slideCount = $el.querySelectorAll('.swiper-slide').length;
        new Swiper($el, {
          slidesPerView: 3,
          spaceBetween: 20,
          loop: slideCount > 7,
          speed: 3000,
          autoplay: {
            delay: 0,
            disableOnInteraction: false
          },
          freeMode: true,
          breakpoints: {
            480: { slidesPerView: 4 },
            768: { slidesPerView: 5 },
            1024: { slidesPerView: 6 },
            1280: { slidesPerView: 7 }
          }
        });
      })">
        <div class="swiper-wrapper items-center">
          {% for block in blocks %}
            <div class="swiper-slide">
              <a href="{{ block.settings.link | default('#') }}"
                 class="flex items-center justify-center p-4 h-20"
                 {% if block.settings.link %}target="_blank" rel="noopener"{% endif %}>
                {% if block.settings.image %}
                  <img src="{{ block.settings.image.fileUrl }}"
                       alt="{{ block.settings.name }}"
                       class="max-h-12 w-auto object-contain {{ grayscaleClass }}">
                {% else %}
                  <span class="text-sm text-gray-400 font-medium">{{ block.settings.name }}</span>
                {% endif %}
              </a>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>
