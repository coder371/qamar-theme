{% set blocks = widget.blocks | default([]) %}
{% set grayscaleClass = 'grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300' if widget.data.grayscale else '' %}

{# Brand fallback macro - shown when no image is provided #}
{% macro brandFallback(name) %}
  <div class="flex flex-col items-center justify-center gap-2 px-4 py-3 h-20 rounded-xl bg-surface border border-theme-border/40 group-hover:border-theme-border group-hover:bg-background transition-all duration-300">
    <div class="w-9 h-9 rounded-lg bg-primary/10 group-hover:bg-primary/20 flex items-center justify-center transition-colors duration-300">
      <span class="text-sm font-bold text-primary">{{ name[0] | upper }}</span>
    </div>
    <span class="text-xs text-theme-text-secondary font-medium truncate max-w-[100px]">{{ name }}</span>
  </div>
{% endmacro %}

<section class="py-10 md:py-14">
  <div class="container mx-auto px-4">
    {# Section Header #}
    {% if widget.data.title %}
      <div class="text-center mb-8">
        <h2 class="text-xl md:text-2xl font-bold text-theme-text">{{ widget.data.title }}</h2>
      </div>
    {% endif %}

    {% if blocks.length %}

      {% if widget.data.layout == 'grid' %}
        {# Grid Layout #}
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-6 items-center">
          {% for block in blocks %}
            <a href="{{ block.settings.link | default('#') }}"
               class="flex items-center justify-center group"
               {% if block.settings.link %}target="_blank" rel="noopener"{% endif %}>
              {% if block.settings.image %}
                <div class="flex items-center justify-center p-4 h-20">
                  <img src="{{ block.settings.image.fileUrl }}"
                       alt="{{ block.settings.name }}"
                       class="max-h-12 w-auto object-contain {{ grayscaleClass }}">
                </div>
              {% else %}
                {{ brandFallback(block.settings.name | default('Brand')) }}
              {% endif %}
            </a>
          {% endfor %}
        </div>

      {% else %}
        {# Slider Layout #}
        <div class="swiper" x-data x-init="$nextTick(() => {
          var slideCount = $el.querySelectorAll('.swiper-slide').length;
          new Swiper($el, {
            slidesPerView: 3,
            spaceBetween: 20,
            loop: slideCount > 7,
            speed: 3000,
            autoplay: {
              delay: 0,
              disableOnInteraction: false
            },
            freeMode: true,
            breakpoints: {
              480: { slidesPerView: 4 },
              768: { slidesPerView: 5 },
              1024: { slidesPerView: 6 },
              1280: { slidesPerView: 7 }
            }
          });
        })">
          <div class="swiper-wrapper items-center">
            {% for block in blocks %}
              <div class="swiper-slide">
                <a href="{{ block.settings.link | default('#') }}"
                   class="flex items-center justify-center group"
                   {% if block.settings.link %}target="_blank" rel="noopener"{% endif %}>
                  {% if block.settings.image %}
                    <div class="flex items-center justify-center p-4 h-20">
                      <img src="{{ block.settings.image.fileUrl }}"
                           alt="{{ block.settings.name }}"
                           class="max-h-12 w-auto object-contain {{ grayscaleClass }}">
                    </div>
                  {% else %}
                    {{ brandFallback(block.settings.name | default('Brand')) }}
                  {% endif %}
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

    {% else %}
      {# Preview / Empty State #}
      <div class="swiper" x-data x-init="$nextTick(() => {
        new Swiper($el, {
          slidesPerView: 3,
          spaceBetween: 20,
          loop: true,
          speed: 3000,
          autoplay: {
            delay: 0,
            disableOnInteraction: false
          },
          freeMode: true,
          breakpoints: {
            480: { slidesPerView: 4 },
            768: { slidesPerView: 5 },
            1024: { slidesPerView: 6 },
            1280: { slidesPerView: 7 }
          }
        });
      })">
        <div class="swiper-wrapper items-center">
          {% for i in range(0, 8) %}
            <div class="swiper-slide">
              <div class="flex items-center justify-center p-4 h-20 rounded-xl bg-surface border border-theme-border/30">
                <div class="animate-pulse flex items-center gap-2">
                  <div class="w-8 h-8 bg-primary/10 rounded-lg"></div>
                  <div class="space-y-1.5 hidden sm:block">
                    <div class="h-2.5 w-14 bg-theme-border/50 rounded-full"></div>
                    <div class="h-2 w-10 bg-theme-border/30 rounded-full"></div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</section>
