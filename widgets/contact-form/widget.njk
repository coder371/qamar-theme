{# Contact Form Widget - Qamar Theme #}
<section class="py-12 md:py-16 lg:py-20">
  <div class="container mx-auto px-4">

    {# Section Header #}
    {% if widget.data.title or widget.data.subtitle %}
      <div class="text-center mb-10 md:mb-14">
        {% if widget.data.title %}
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 mb-3">
            {{ widget.data.title }}
          </h1>
        {% endif %}
        {% if widget.data.subtitle %}
          <p class="text-gray-500 text-sm md:text-base max-w-xl mx-auto">
            {{ widget.data.subtitle | safe }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 {% if widget.data.show_info %}lg:grid-cols-5 gap-8 lg:gap-12{% endif %}">

        {# Contact Form #}
        <div class="{% if widget.data.show_info %}lg:col-span-3{% endif %}"
             x-data="{
               form: {
                 name: '',
                 email: '',
                 phone: '',
                 subject: '',
                 message: ''
               },
               submitting: false,
               submitted: false,
               error: false,
               async submitForm() {
                 this.submitting = true;
                 this.error = false;
                 try {
                   const response = await fetch('/api/contact', {
                     method: 'POST',
                     headers: { 'Content-Type': 'application/json' },
                     body: JSON.stringify(this.form)
                   });
                   if (response.ok) {
                     this.submitted = true;
                     this.form = { name: '', email: '', phone: '', subject: '', message: '' };
                   } else {
                     this.error = true;
                   }
                 } catch (e) {
                   this.error = true;
                 } finally {
                   this.submitting = false;
                 }
               }
             }">

          {# Success Message #}
          <div x-show="submitted" x-cloak
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="opacity-0 -translate-y-2"
               x-transition:enter-end="opacity-100 translate-y-0"
               class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-center gap-3">
            <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-green-700 text-sm font-medium">{{t('contact.success')}}</p>
          </div>

          {# Error Message #}
          <div x-show="error" x-cloak
               class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-center gap-3">
            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-red-700 text-sm font-medium">{{t('common.error')}}</p>
          </div>

          <form @submit.prevent="submitForm()" class="space-y-5">
            {# Name & Email Row #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {# Name #}
              <div>
                <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-1.5">
                  {{t('contact.name')}} <span class="text-red-400">*</span>
                </label>
                <input type="text" id="contact-name"
                       x-model="form.name"
                       required
                       class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white
                              text-gray-900 text-sm placeholder-gray-400
                              focus:ring-2 focus:ring-primary/20 focus:border-primary
                              transition-colors duration-200"
                       placeholder="{{t('contact.name')}}">
              </div>

              {# Email #}
              <div>
                <label for="contact-email" class="block text-sm font-medium text-gray-700 mb-1.5">
                  {{t('contact.email')}} <span class="text-red-400">*</span>
                </label>
                <input type="email" id="contact-email"
                       x-model="form.email"
                       required
                       class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white
                              text-gray-900 text-sm placeholder-gray-400
                              focus:ring-2 focus:ring-primary/20 focus:border-primary
                              transition-colors duration-200"
                       placeholder="{{t('contact.email')}}">
              </div>
            </div>

            {# Phone & Subject Row #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {# Phone #}
              <div>
                <label for="contact-phone" class="block text-sm font-medium text-gray-700 mb-1.5">
                  {{t('contact.phone')}}
                </label>
                <input type="tel" id="contact-phone"
                       x-model="form.phone"
                       class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white
                              text-gray-900 text-sm placeholder-gray-400
                              focus:ring-2 focus:ring-primary/20 focus:border-primary
                              transition-colors duration-200"
                       placeholder="{{t('contact.phone')}}">
              </div>

              {# Subject #}
              <div>
                <label for="contact-subject" class="block text-sm font-medium text-gray-700 mb-1.5">
                  {{t('contact.subject')}} <span class="text-red-400">*</span>
                </label>
                <input type="text" id="contact-subject"
                       x-model="form.subject"
                       required
                       class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white
                              text-gray-900 text-sm placeholder-gray-400
                              focus:ring-2 focus:ring-primary/20 focus:border-primary
                              transition-colors duration-200"
                       placeholder="{{t('contact.subject')}}">
              </div>
            </div>

            {# Message #}
            <div>
              <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-1.5">
                {{t('contact.message')}} <span class="text-red-400">*</span>
              </label>
              <textarea id="contact-message"
                        x-model="form.message"
                        required
                        rows="6"
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white
                               text-gray-900 text-sm placeholder-gray-400 resize-none
                               focus:ring-2 focus:ring-primary/20 focus:border-primary
                               transition-colors duration-200"
                        placeholder="{{t('contact.message')}}"></textarea>
            </div>

            {# Submit Button #}
            <div>
              <button type="submit"
                      :disabled="submitting"
                      class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark
                             text-white font-medium px-8 py-3.5 rounded-xl w-full sm:w-auto
                             transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5
                             disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0
                             disabled:hover:shadow-none">
                <template x-if="!submitting">
                  <span class="flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    {{t('contact.send')}}
                  </span>
                </template>
                <template x-if="submitting">
                  <span class="flex items-center gap-2">
                    <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
                    </svg>
                    {{t('common.loading')}}
                  </span>
                </template>
              </button>
            </div>
          </form>
        </div>

        {# Contact Info Sidebar #}
        {% if widget.data.show_info %}
          <div class="lg:col-span-2">
            <div class="bg-surface rounded-2xl p-6 md:p-8 h-full">
              <h2 class="text-lg font-bold text-gray-900 mb-6">
                {{t('contact.info_title')}}
              </h2>

              <div class="space-y-6">
                {# Address #}
                {% if widget.data.address %}
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-semibold text-gray-900 mb-1">{{t('contact.address')}}</h3>
                      <p class="text-sm text-gray-500 leading-relaxed">{{ widget.data.address | safe }}</p>
                    </div>
                  </div>
                {% endif %}

                {# Phone #}
                {% if widget.data.phone %}
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-semibold text-gray-900 mb-1">{{t('contact.phone')}}</h3>
                      <a href="tel:{{ widget.data.phone }}" class="text-sm text-gray-500 hover:text-primary transition-colors" dir="ltr">
                        {{ widget.data.phone }}
                      </a>
                    </div>
                  </div>
                {% endif %}

                {# Email #}
                {% if widget.data.email %}
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-semibold text-gray-900 mb-1">{{t('contact.email')}}</h3>
                      <a href="mailto:{{ widget.data.email }}" class="text-sm text-gray-500 hover:text-primary transition-colors">
                        {{ widget.data.email }}
                      </a>
                    </div>
                  </div>
                {% endif %}

                {# Working Hours #}
                {% if widget.data.working_hours %}
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-sm font-semibold text-gray-900 mb-1">{{t('contact.working_hours')}}</h3>
                      <p class="text-sm text-gray-500">{{ widget.data.working_hours }}</p>
                    </div>
                  </div>
                {% endif %}
              </div>

              {# Map Embed #}
              {% if widget.data.show_map and widget.data.map_embed %}
                <div class="mt-8 rounded-xl overflow-hidden border border-gray-100">
                  {{ widget.data.map_embed | safe }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

      </div>
    </div>

  </div>
</section>
