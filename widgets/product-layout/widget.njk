{# Product Layout Widget - Qamar Theme #}
{% set product = context.product %}
{% set imagePosition = widget.data.image_position | default('start') %}
{% set canPurchase = product.quantity > 0 or not product.trackQuantity or product.allowBackorder %}
{% set hasDiscount = product.pricing.compareAtPrice and product.pricing.compareAtPrice > product.pricing.price %}

<section id="product-{{ widget.id }}" class="product-layout py-4 md:py-8">
  <div class="container mx-auto px-4">

    {# ===== BREADCRUMB ===== #}
    <nav class="mb-4 md:mb-6" aria-label="breadcrumb">
      <ol class="flex items-center gap-1.5 flex-wrap text-xs md:text-sm text-theme-text-secondary/70">
        <li><a href="/" class="hover:text-primary transition-colors">{{t('common.home')}}</a></li>
        <li><svg class="w-3 h-3 rtl:rotate-180 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
        {% if product.collections | length %}
          <li><a href="/shop/{{ product.collections[0].slug }}" class="hover:text-primary transition-colors">{{ product.collections[0].title }}</a></li>
        {% else %}
          <li><a href="/shop" class="hover:text-primary transition-colors">{{t('common.products')}}</a></li>
        {% endif %}
        <li><svg class="w-3 h-3 rtl:rotate-180 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></li>
        <li class="text-theme-text-secondary font-medium truncate max-w-[180px]">{{ product.title }}</li>
      </ol>
    </nav>

    {# ===== MAIN PRODUCT GRID ===== #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12"
         x-data="productPage_{{ widget.id }}()"
         x-init="init()">

      {# ===== IMAGE GALLERY ===== #}
      <div class="{% if imagePosition == 'end' %}lg:order-2{% endif %}">
        <div class="lg:sticky lg:top-24 relative">

          {# Badges #}
          <div class="absolute top-3 start-3 z-10 flex flex-col gap-1.5">
            {% if hasDiscount %}
              {% set discountPercent = (((product.pricing.compareAtPrice - product.pricing.price) / product.pricing.compareAtPrice) * 100) | round %}
              <span class="bg-red-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-full">-{{ discountPercent }}%</span>
            {% endif %}
          </div>

          {# Main Image Swiper #}
          <div class="product-main swiper rounded-2xl overflow-hidden bg-surface border border-theme-border/40 relative">
            <div class="swiper-wrapper">
              {% if product.images | length %}
                {% for image in product.images %}
                  <div class="swiper-slide">
                    <div class="product-zoom-wrap overflow-hidden"
                         @mouseenter="zooming = true"
                         @mouseleave="zooming = false; zoomX = 50; zoomY = 50"
                         @mousemove="if(zooming) { var rect = $el.getBoundingClientRect(); zoomX = ((event.clientX - rect.left) / rect.width) * 100; zoomY = ((event.clientY - rect.top) / rect.height) * 100; }">
                      <a href="{{ image.fileUrl }}"
                         class="product-gallery-item block"
                         {% if widget.data.image_zoom %}data-gallery="product-gallery"{% endif %}>
                        <img src="{{ image.fileUrl }}"
                             alt="{{ product.title }} - {{ loop.index }}"
                             class="w-full aspect-square object-contain p-4 transition-transform duration-200 pointer-events-none"
                             :style="zooming ? 'transform: scale(2); transform-origin: ' + zoomX + '% ' + zoomY + '%' : ''"
                             loading="{% if loop.first %}eager{% else %}lazy{% endif %}">
                      </a>
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                <div class="swiper-slide">
                  <div class="w-full aspect-square bg-surface flex items-center justify-center">
                    <svg class="w-20 h-20 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                </div>
              {% endif %}
            </div>

            {# Image Navigation Arrows #}
            {% if product.images | length > 1 %}
              <button class="swiper-btn-prev-main absolute top-1/2 -translate-y-1/2 start-2 z-10
                             w-9 h-9 rounded-full bg-white/80 shadow backdrop-blur-sm
                             flex items-center justify-center text-theme-text-secondary hover:text-primary transition-all">
                <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button class="swiper-btn-next-main absolute top-1/2 -translate-y-1/2 end-2 z-10
                             w-9 h-9 rounded-full bg-white/80 shadow backdrop-blur-sm
                             flex items-center justify-center text-theme-text-secondary hover:text-primary transition-all">
                <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
              </button>
            {% endif %}
          </div>

          {# Thumbnails #}
          {% if product.images | length > 1 %}
            <div class="product-thumbs swiper mt-3">
              <div class="swiper-wrapper">
                {% for image in product.images %}
                  <div class="swiper-slide cursor-pointer rounded-lg overflow-hidden border-2 transition-all duration-200"
                       :class="activeImageIndex === {{ loop.index0 }} ? 'border-primary' : 'border-theme-border/40 hover:border-gray-300'">
                    <img src="{{ image.fileUrl }}"
                         alt="{{ product.title }} - {{ loop.index }}"
                         class="w-full aspect-square object-cover"
                         loading="lazy">
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

        </div>
      </div>

      {# ===== PRODUCT INFO ===== #}
      <div class="{% if imagePosition == 'end' %}lg:order-1{% endif %} flex flex-col">

        {# Title #}
        <h1 class="text-xl md:text-2xl lg:text-3xl font-bold text-theme-text leading-tight">{{ product.title }}</h1>

        {# Rating #}
        {% if product.averageRating > 0 %}
          <div class="flex items-center gap-1.5 mt-2">
            <div class="flex items-center gap-0.5">
              {% for i in range(5) %}
                <svg class="w-3.5 h-3.5 {% if i < product.averageRating %}text-amber-400{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {% endfor %}
            </div>
            <span class="text-xs text-theme-text-secondary/70">({{ product.reviewsCount }})</span>
          </div>
        {% endif %}

        {# Price #}
        <div class="flex items-baseline gap-3 flex-wrap mt-3">
          <span class="text-2xl md:text-3xl font-bold text-primary" x-text="currentPrice">{{ product.pricing.price | money }}</span>
          <template x-if="currentComparePrice">
            <span class="text-sm md:text-base text-theme-text-secondary/70 line-through" x-text="currentComparePrice">
              {% if hasDiscount %}{{ product.pricing.compareAtPrice | money }}{% endif %}
            </span>
          </template>
          {% if hasDiscount %}
            <span class="bg-red-50 text-red-600 text-xs font-bold px-2 py-0.5 rounded-full"
                  x-show="discountPercent > 0"
                  x-text="'- ' + discountPercent + '%'">
              - {{ (((product.pricing.compareAtPrice - product.pricing.price) / product.pricing.compareAtPrice) * 100) | round }}%
            </span>
          {% endif %}
        </div>

        {# Short Description #}
        {% if product.description %}
          <div class="product-short-desc text-theme-text-secondary text-sm leading-relaxed mt-3 line-clamp-3">
            {{ product.description | safe }}
          </div>
        {% endif %}

        {# SKU #}
        {% if widget.data.show_sku and product.sku %}
          <p class="text-xs text-theme-text-secondary/70 mt-2">
            {{t('product.sku')}}: <span>{{ product.sku }}</span>
          </p>
        {% endif %}

        <hr class="my-5 border-theme-border/40">

        {# Variant Options #}
        {% if product.options | length > 0 %}
          <div class="space-y-4 mb-5">
            {% for option in product.options %}
              <div>
                <label class="block text-sm font-semibold text-theme-text mb-2">
                  {{ option.name }}: <span class="font-normal text-primary" x-text="selectedLabels['{{ option.name }}']"></span>
                </label>
                <div class="flex flex-wrap gap-{% if option.type == 'color' %}3 pb-7{% else %}2{% endif %}">
                  {% for value in option.values %}
                    {% if option.type == 'color' %}
                      {# Color Swatch #}
                      <button type="button"
                              @click="selectOption('{{ option.name }}', '{{ value._id }}', '{{ value.label }}')"
                              :class="selectedOptions['{{ option.name }}'] === '{{ value._id }}'
                                ? 'border-primary scale-110 shadow-md'
                                : 'border-theme-border hover:scale-105 hover:shadow'"
                              class="group relative w-10 h-10 rounded-full border-2 transition-all duration-200"
                              title="{{ value.label }}">
                        <span class="absolute inset-1 rounded-full shadow-inner"
                              style="background-color: {{ value.value | default('#ffffff') }}">
                        </span>
                        {% if not value.value %}
                          <span class="absolute inset-1 rounded-full border border-gray-300 border-dashed"></span>
                        {% endif %}
                        <span class="absolute inset-0 rounded-full"
                              :class="selectedOptions['{{ option.name }}'] === '{{ value._id }}'
                                ? 'ring-2 ring-primary ring-offset-1' : ''">
                        </span>
                        <span class="absolute -bottom-6 start-1/2 -translate-x-1/2 text-[10px] text-theme-text-secondary whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                          {{ value.label }}
                        </span>
                      </button>
                    {% else %}
                      {# Text Button #}
                      <button type="button"
                              @click="selectOption('{{ option.name }}', '{{ value._id }}', '{{ value.label }}')"
                              :class="selectedOptions['{{ option.name }}'] === '{{ value._id }}'
                                ? 'border-primary bg-primary/5 text-primary ring-1 ring-primary/30'
                                : 'border-theme-border text-theme-text-secondary hover:border-theme-text-secondary'"
                              class="px-3 py-2 rounded-lg border text-sm font-medium transition-all min-w-[2.5rem] text-center">
                        {{ value.label }}
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {# Stock Status #}
        <div class="flex items-center gap-2 text-sm mb-4">
          <template x-if="!isOutOfStock">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
              <span class="text-green-600 font-medium text-xs">{{t('product.in_stock')}}</span>
            </div>
          </template>
          <template x-if="isOutOfStock">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
              <span class="text-red-600 font-medium text-xs">{{t('product.out_of_stock')}}</span>
            </div>
          </template>
        </div>

        {# Quantity + Add to Cart #}
        <div class="flex items-center gap-3">
          {# Quantity #}
          <div class="flex items-center border border-theme-border rounded-xl shrink-0">
            <button type="button" @click="qty > 1 && qty--" :disabled="qty <= 1"
                    class="w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-theme-text-secondary hover:bg-surface transition-colors disabled:opacity-30">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/></svg>
            </button>
            <span class="w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-sm font-bold border-x border-theme-border" x-text="qty">1</span>
            <button type="button" @click="qty < 99 && qty++"
                    class="w-10 h-10 md:w-11 md:h-11 flex items-center justify-center text-theme-text-secondary hover:bg-surface transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            </button>
          </div>

          {# Add to Cart #}
          <button type="button" @click="addToCart()" :disabled="isOutOfStock || addingToCart"
                  class="flex-1 h-10 md:h-11 rounded-xl font-semibold text-sm transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
                  :class="addedSuccess ? 'bg-green-500 text-white' : 'bg-primary text-white hover:bg-primary-dark'">
            <template x-if="addingToCart">
              <span class="flex items-center justify-center gap-2">
                <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                {{t('common.loading')}}
              </span>
            </template>
            <template x-if="addedSuccess && !addingToCart">
              <span class="flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                {{t('product.added')}}
              </span>
            </template>
            <template x-if="!addingToCart && !addedSuccess">
              <span class="flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                {{ t('product.add_to_cart_f') if settings.addressingTone == 'feminine' else t('product.add_to_cart') }}
              </span>
            </template>
          </button>
        </div>

        {# Trust Features + Share #}
        <div class="flex items-center justify-between mt-5 pt-5 border-t border-theme-border/40">
          {# Trust Icons #}
          <div class="flex items-center gap-3 md:gap-4">
            <div class="flex items-center gap-1.5 text-theme-text-secondary/70">
              <svg class="w-4 h-4 text-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
              <span class="text-[11px] hidden sm:inline">{{t('features.free_shipping')}}</span>
            </div>
            <div class="flex items-center gap-1.5 text-theme-text-secondary/70">
              <svg class="w-4 h-4 text-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              <span class="text-[11px] hidden sm:inline">{{t('features.secure_payment')}}</span>
            </div>
            <div class="flex items-center gap-1.5 text-theme-text-secondary/70">
              <svg class="w-4 h-4 text-primary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              <span class="text-[11px] hidden sm:inline">{{t('features.easy_returns')}}</span>
            </div>
          </div>

          {# Share Buttons #}
          {% if widget.data.show_share %}
            <div class="flex items-center gap-1.5">
              <a :href="'https://twitter.com/intent/tweet?url=' + encodeURIComponent(window.location.href) + '&text=' + encodeURIComponent('{{ product.title }}')"
                 target="_blank" rel="noopener noreferrer"
                 class="w-8 h-8 rounded-full bg-surface hover:bg-surface flex items-center justify-center text-theme-text-secondary/70 hover:text-theme-text-secondary transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a :href="'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.href)"
                 target="_blank" rel="noopener noreferrer"
                 class="w-8 h-8 rounded-full bg-surface hover:bg-surface flex items-center justify-center text-theme-text-secondary/70 hover:text-theme-text-secondary transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a :href="'https://api.whatsapp.com/send?text=' + encodeURIComponent('{{ product.title }}' + ' ' + window.location.href)"
                 target="_blank" rel="noopener noreferrer"
                 class="w-8 h-8 rounded-full bg-surface hover:bg-surface flex items-center justify-center text-theme-text-secondary/70 hover:text-theme-text-secondary transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
              <button type="button" @click="copyLink()"
                      class="w-8 h-8 rounded-full bg-surface hover:bg-surface flex items-center justify-center text-theme-text-secondary/70 hover:text-theme-text-secondary transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              </button>
            </div>
          {% endif %}
        </div>

      </div>
    </div>

    {# ===== PRODUCT TABS ===== #}
    {% if widget.data.show_tabs %}
      <div x-data="{ activeTab: 'description' }" class="mt-10 md:mt-14">
        <div class="bg-surface/80 rounded-2xl overflow-hidden">

          {# Tab Headers #}
          <div class="flex border-b border-theme-border/50 px-4 md:px-6 overflow-x-auto custom-scrollbar">
            <button type="button"
                    @click="activeTab = 'description'"
                    :class="activeTab === 'description' ? 'border-primary text-primary' : 'border-transparent text-theme-text-secondary/70 hover:text-theme-text-secondary'"
                    class="px-4 py-3.5 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap -mb-px">
              {{t('product.description')}}
            </button>
            {% if product.metadata %}
              <button type="button"
                      @click="activeTab = 'specifications'"
                      :class="activeTab === 'specifications' ? 'border-primary text-primary' : 'border-transparent text-theme-text-secondary/70 hover:text-theme-text-secondary'"
                      class="px-4 py-3.5 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap -mb-px">
                {{t('product.specifications')}}
              </button>
            {% endif %}
            <button type="button"
                    @click="activeTab = 'shipping'"
                    :class="activeTab === 'shipping' ? 'border-primary text-primary' : 'border-transparent text-theme-text-secondary/70 hover:text-theme-text-secondary'"
                    class="px-4 py-3.5 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap -mb-px">
              {{t('product.shipping_info')}}
            </button>
            {% if product.reviews | length > 0 %}
              <button type="button"
                      @click="activeTab = 'reviews'"
                      :class="activeTab === 'reviews' ? 'border-primary text-primary' : 'border-transparent text-theme-text-secondary/70 hover:text-theme-text-secondary'"
                      class="px-4 py-3.5 text-sm font-semibold border-b-2 transition-colors whitespace-nowrap -mb-px">
                {{t('product.reviews')}} ({{ product.reviewsCount }})
              </button>
            {% endif %}
          </div>

          {# Tab Content #}
          <div class="p-4 md:p-6 lg:p-8">

            {# Description #}
            <div x-show="activeTab === 'description'" x-cloak>
              {% if product.description %}
                <div class="prose prose-sm max-w-none text-theme-text-secondary leading-relaxed
                            prose-headings:text-theme-text prose-a:text-primary
                            prose-img:rounded-xl prose-p:my-2">
                  {{ product.description | safe }}
                </div>
              {% else %}
                <p class="text-theme-text-secondary/70 text-sm">{{t('product.description')}}</p>
              {% endif %}
            </div>

            {# Specifications #}
            {% if product.metadata %}
              <div x-show="activeTab === 'specifications'" x-cloak>
                <table class="w-full text-sm">
                  <tbody>
                    {% for key, value in product.metadata %}
                      <tr class="{% if loop.index is odd %}bg-white/60{% endif %}">
                        <td class="px-3 py-2.5 font-semibold text-theme-text w-1/3 rounded-s-lg">{{ key }}</td>
                        <td class="px-3 py-2.5 text-theme-text-secondary rounded-e-lg">{{ value }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}

            {# Shipping #}
            <div x-show="activeTab === 'shipping'" x-cloak>
              {% if widget.data.shipping_info %}
                <div class="prose prose-sm max-w-none text-theme-text-secondary leading-relaxed">
                  {{ widget.data.shipping_info | safe }}
                </div>
              {% else %}
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div class="flex items-start gap-3 p-3 bg-white rounded-xl">
                    <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                    </div>
                    <div>
                      <h4 class="text-sm font-semibold text-theme-text">{{t('features.free_shipping')}}</h4>
                      <p class="text-xs text-theme-text-secondary mt-0.5">{{t('features.free_shipping_desc')}}</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-3 bg-white rounded-xl">
                    <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </div>
                    <div>
                      <h4 class="text-sm font-semibold text-theme-text">{{t('features.easy_returns')}}</h4>
                      <p class="text-xs text-theme-text-secondary mt-0.5">{{t('features.easy_returns_desc')}}</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 p-3 bg-white rounded-xl">
                    <div class="w-9 h-9 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <div>
                      <h4 class="text-sm font-semibold text-theme-text">{{t('features.secure_payment')}}</h4>
                      <p class="text-xs text-theme-text-secondary mt-0.5">{{t('features.secure_payment_desc')}}</p>
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>

            {# Reviews #}
            {% if product.reviews | length > 0 %}
              <div x-show="activeTab === 'reviews'" x-cloak>
                {# Rating Summary #}
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-8 pb-6 border-b border-theme-border/50">
                  <div class="text-center shrink-0">
                    <div class="text-4xl font-bold text-theme-text">{{ product.averageRating }}</div>
                    <div class="flex items-center gap-0.5 mt-1 justify-center">
                      {% for i in range(5) %}
                        <svg class="w-4 h-4 {% if i < product.averageRating | round %}text-amber-400{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      {% endfor %}
                    </div>
                    <div class="text-xs text-theme-text-secondary/70 mt-1">{{ product.reviewsCount }} {{t('product.reviews')}}</div>
                  </div>

                  {# Rating Bars #}
                  {% if product.ratings %}
                    <div class="flex-1 w-full space-y-1.5">
                      {% for star in [5, 4, 3, 2, 1] %}
                        {% set count = product.ratings[star] | default(0) %}
                        {% set percent = ((count / product.reviewsCount) * 100) | round if product.reviewsCount > 0 else 0 %}
                        <div class="flex items-center gap-2">
                          <span class="text-xs text-theme-text-secondary w-4 text-center">{{ star }}</span>
                          <svg class="w-3 h-3 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                          <div class="flex-1 h-2 bg-surface rounded-full overflow-hidden">
                            <div class="h-full bg-amber-400 rounded-full transition-all" style="width: {{ percent }}%"></div>
                          </div>
                          <span class="text-xs text-theme-text-secondary/70 w-6 text-end">{{ count }}</span>
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>

                {# Individual Reviews #}
                <div class="space-y-6">
                  {% for review in product.reviews %}
                    <div class="{% if not loop.last %}pb-6 border-b border-theme-border/40{% endif %}">
                      <div class="flex items-start gap-3">
                        {% if review.avatar %}
                          <img src="{{ review.avatar.fileUrl }}" alt="{{ review.customerName }}" class="w-10 h-10 rounded-full object-cover shrink-0">
                        {% else %}
                          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm shrink-0">
                            {{ review.customerName | first }}
                          </div>
                        {% endif %}
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center justify-between gap-2">
                            <h4 class="text-sm font-semibold text-theme-text">{{ review.customerName }}</h4>
                          </div>
                          <div class="flex items-center gap-0.5 mt-0.5">
                            {% for i in range(5) %}
                              <svg class="w-3 h-3 {% if i < review.rating %}text-amber-400{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                              </svg>
                            {% endfor %}
                          </div>
                          {% if review.comment %}
                            <p class="text-sm text-theme-text-secondary mt-2 leading-relaxed">{{ review.comment }}</p>
                          {% endif %}
                          {% if review.images | length > 0 %}
                            <div class="flex gap-2 mt-3 flex-wrap">
                              {% for img in review.images %}
                                <a href="{{ img.fileUrl }}" data-gallery="review-{{ review._id }}" class="review-image-item">
                                  <img src="{{ img.fileUrl }}" alt="" class="w-16 h-16 rounded-lg object-cover border border-theme-border/40 hover:border-primary/30 transition-colors">
                                </a>
                              {% endfor %}
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

          </div>
        </div>
      </div>
    {% endif %}

  </div>

  {# ===== JAVASCRIPT ===== #}
  <script>
    (function() {
      var wid = '{{ widget.id }}';
      var container = null;

      window['productPage_' + wid] = function() {
        return {
          qty: 1,
          activeImageIndex: 0,
          addingToCart: false,
          addedSuccess: false,
          variantSelected: false,
          selectedOptions: {},
          selectedLabels: {},
          zooming: false,
          zoomX: 50,
          zoomY: 50,
          currentVariantId: null,
          currentVariantQuantity: {{ product.quantity | default(0) }},
          currentPrice: '{{ product.pricing.price | money }}',
          currentComparePrice: {% if hasDiscount %}'{{ product.pricing.compareAtPrice | money }}'{% else %}null{% endif %},
          discountPercent: {% if hasDiscount %}{{ (((product.pricing.compareAtPrice - product.pricing.price) / product.pricing.compareAtPrice) * 100) | round }}{% else %}0{% endif %},
          isOutOfStock: {{ 'true' if not canPurchase else 'false' }},

          variants: [
            {% for variant in product.variants %}
            {
              id: '{{ variant._id }}',
              price: {{ variant.pricing.price | default(0) }},
              priceFormatted: '{{ variant.pricing.price | money }}',
              compareAtPrice: {{ variant.pricing.compareAtPrice | default(0) }},
              compareAtPriceFormatted: '{{ variant.pricing.compareAtPrice | money }}',
              quantity: {{ variant.quantity | default(0) }},
              trackQuantity: {{ 'true' if variant.trackQuantity else 'false' }},
              allowBackorder: {{ 'true' if variant.allowBackorder else 'false' }},
              options: {{ variant.options | dump | safe }}
            }{% if not loop.last %},{% endif %}
            {% endfor %}
          ],

          init() {
            container = document.getElementById('product-' + wid);
            var self = this;

            var thumbsSwiper = null;
            {% if product.images | length > 1 %}
              thumbsSwiper = new Swiper(container.querySelector('.product-thumbs'), {
                spaceBetween: 8,
                slidesPerView: 4,
                freeMode: true,
                watchSlidesProgress: true,
                breakpoints: {
                  640: { slidesPerView: 5 },
                  1024: { slidesPerView: 5 }
                }
              });
            {% endif %}

            new Swiper(container.querySelector('.product-main'), {
              spaceBetween: 0,
              {% if product.images | length > 1 %}
              thumbs: { swiper: thumbsSwiper },
              navigation: {
                nextEl: container.querySelector('.swiper-btn-next-main'),
                prevEl: container.querySelector('.swiper-btn-prev-main')
              },
              {% endif %}
              on: {
                slideChange: function() {
                  self.activeImageIndex = this.activeIndex;
                }
              }
            });

            {% if widget.data.image_zoom %}
              GLightbox({
                selector: '#product-' + wid + ' .product-gallery-item',
                touchNavigation: true,
                loop: true,
                closeOnOutsideClick: true
              });

              GLightbox({
                selector: '#product-' + wid + ' .review-image-item',
                touchNavigation: true,
                loop: true,
                closeOnOutsideClick: true
              });
            {% endif %}

            {% for option in product.options %}
              {% if option.values | length > 0 %}
                this.selectedOptions['{{ option.name }}'] = '{{ option.values[0]._id }}';
                this.selectedLabels['{{ option.name }}'] = '{{ option.values[0].label }}';
              {% endif %}
            {% endfor %}

            {% if product.options | length > 0 %}
              this.variantSelected = true;
              this.matchVariant();
            {% endif %}
          },

          selectOption(name, valueId, label) {
            this.selectedOptions[name] = valueId;
            this.selectedLabels[name] = label;
            this.variantSelected = true;
            this.matchVariant();
          },

          matchVariant() {
            var self = this;
            var selectedIds = Object.values(self.selectedOptions);

            var matched = this.variants.find(function(v) {
              if (!v.options || !v.options.length) return false;
              if (v.options.length !== selectedIds.length) return false;
              for (var i = 0; i < selectedIds.length; i++) {
                if (v.options.indexOf(selectedIds[i]) === -1) return false;
              }
              return true;
            });

            if (matched) {
              this.currentVariantId = matched.id;
              this.currentPrice = matched.priceFormatted;
              this.currentVariantQuantity = matched.quantity;

              if (matched.trackQuantity && !matched.allowBackorder) {
                this.isOutOfStock = matched.quantity <= 0;
              } else {
                this.isOutOfStock = false;
              }

              if (matched.compareAtPrice && matched.compareAtPrice > matched.price) {
                this.currentComparePrice = matched.compareAtPriceFormatted;
                this.discountPercent = Math.round(((matched.compareAtPrice - matched.price) / matched.compareAtPrice) * 100);
              } else {
                this.currentComparePrice = null;
                this.discountPercent = 0;
              }
            }
          },

          async addToCart() {
            if (this.isOutOfStock || this.addingToCart) return;
            this.addingToCart = true;
            try {
              var optionIds = Object.values(this.selectedOptions);
              await Qumra.cart.add('{{ product._id }}', this.qty, optionIds.length ? optionIds : null);
              this.addedSuccess = true;
              setTimeout(() => { this.addedSuccess = false; }, 2000);
            } catch (err) {
              console.error('Add to cart error:', err);
            } finally {
              this.addingToCart = false;
            }
          },

          copyLink() {
            if (navigator.clipboard) {
              navigator.clipboard.writeText(window.location.href);
            }
          }
        };
      };
    })();
  </script>

  <style>
    #product-{{ widget.id }} .product-thumbs .swiper-slide {
      opacity: 0.5;
      transition: opacity 0.3s ease;
    }
    #product-{{ widget.id }} .product-thumbs .swiper-slide-thumb-active {
      opacity: 1;
    }
    #product-{{ widget.id }} .product-short-desc * {
      display: inline;
    }
    #product-{{ widget.id }} .product-short-desc img,
    #product-{{ widget.id }} .product-short-desc br {
      display: none;
    }
    #product-{{ widget.id }} .prose img {
      border-radius: 0.75rem;
    }
    #product-{{ widget.id }} .prose {
      font-size: 0.9375rem;
      line-height: 1.8;
    }
    #product-{{ widget.id }} .product-zoom-wrap {
      cursor: zoom-in;
    }
    @media (max-width: 1023px) {
      #product-{{ widget.id }} .product-zoom-wrap {
        cursor: default;
      }
      #product-{{ widget.id }} .product-zoom-wrap img {
        transform: none !important;
      }
    }
  </style>
</section>
