{# Predictive Search Widget - rendered by backend via ?widgetKey=predictive-search #}
{% set shop = context.shop | default({}) %}
{% set products = shop.products | default([]) %}
{% set collections = shop.collections | default([]) %}
{% set articles = shop.articles | default([]) %}
{% set query = shop.query | default('') %}
{% set hasProducts = products | length > 0 %}
{% set hasCollections = collections | length > 0 %}
{% set hasArticles = articles | length > 0 %}
{% set hasResults = hasProducts or hasCollections or hasArticles %}

<div id="predictive-search-results">
  {% if query and hasResults %}

    {# Products #}
    {% if hasProducts %}
      <div class="mb-4">
        <h4 class="text-xs font-semibold text-theme-text-secondary/70 uppercase tracking-wider mb-2 px-1">{{t('common.products')}}</h4>
        {% for product in products %}
          <a href="/product/{{ product.slug }}"
             class="predict-item flex items-center gap-3 py-2 px-1 hover:bg-surface rounded-lg transition-colors">
            <div class="w-12 h-12 rounded-lg overflow-hidden bg-surface flex-shrink-0 flex items-center justify-center">
              {% if product.images | length %}
                <img src="{{ product.images[0].fileUrl }}" alt="{{ product.title }}" class="w-full h-full object-cover" loading="lazy">
              {% else %}
                <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              {% endif %}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-theme-text truncate">{{ product.title }}</p>
              <div class="flex items-baseline gap-2">
                <span class="text-xs text-primary font-bold">{{ product.pricing.price | money }}</span>
                {% if product.pricing.compareAtPrice and product.pricing.compareAtPrice > product.pricing.price %}
                  <span class="text-[10px] text-theme-text-secondary/70 line-through">{{ product.pricing.compareAtPrice | money }}</span>
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {# Collections #}
    {% if hasCollections %}
      <div class="mb-4">
        <h4 class="text-xs font-semibold text-theme-text-secondary/70 uppercase tracking-wider mb-2 px-1">{{t('search.collections')}}</h4>
        {% for collection in collections %}
          <a href="/shop/{{ collection.handle }}"
             class="predict-item flex items-center gap-3 py-2 px-1 hover:bg-surface rounded-lg transition-colors">
            <div class="w-10 h-10 rounded-lg overflow-hidden bg-surface flex-shrink-0 flex items-center justify-center">
              {% if collection.image and collection.image.fileUrl %}
                <img src="{{ collection.image.fileUrl }}" alt="{{ collection.title }}" class="w-full h-full object-cover" loading="lazy">
              {% else %}
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              {% endif %}
            </div>
            <span class="text-sm font-medium text-theme-text">{{ collection.title }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {# Articles #}
    {% if hasArticles %}
      <div class="mb-4">
        <h4 class="text-xs font-semibold text-theme-text-secondary/70 uppercase tracking-wider mb-2 px-1">{{t('search.articles')}}</h4>
        {% for article in articles %}
          <a href="/article/{{ article.slug }}"
             class="predict-item flex items-center gap-3 py-2 px-1 hover:bg-surface rounded-lg transition-colors">
            <div class="w-10 h-10 rounded-lg overflow-hidden bg-surface flex-shrink-0 flex items-center justify-center">
              {% if article.image and article.image.fileUrl %}
                <img src="{{ article.image.fileUrl }}" alt="{{ article.title }}" class="w-full h-full object-cover" loading="lazy">
              {% else %}
                <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              {% endif %}
            </div>
            <span class="text-sm font-medium text-theme-text">{{ article.title }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {# View all results #}
    <a href="/shop?q={{ query | urlencode }}"
       class="flex items-center justify-center gap-2 py-3 text-sm font-semibold text-primary hover:bg-primary/5 rounded-xl transition-colors">
      {{t('search.view_all_results')}}
      <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>

  {% elif query %}
    {# No results #}
    <div class="py-8 text-center">
      <svg class="w-10 h-10 text-gray-200 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <p class="text-sm text-theme-text-secondary">{{t('search.no_results')}} "{{ query }}"</p>
      <p class="text-xs text-theme-text-secondary/70 mt-1">{{ t('search.try_different_f') if settings.addressingTone == 'feminine' else t('search.try_different') }}</p>
    </div>
  {% endif %}
</div>
