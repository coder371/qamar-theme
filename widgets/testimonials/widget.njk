<section style="background-color: {{ widget.data.background_color | default('#FAFAFA') }};" class="py-12 md:py-16">
  <div class="container mx-auto px-4">
    {# Section Header #}
    {% if widget.data.title or widget.data.subtitle %}
      <div class="text-center mb-10">
        {% if widget.data.title %}
          <h2 class="text-2xl md:text-3xl font-bold text-theme-text mb-3">{{ widget.data.title }}</h2>
        {% endif %}
        {% if widget.data.subtitle %}
          <p class="text-theme-text-secondary text-sm md:text-base max-w-xl mx-auto">{{ widget.data.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% set blocks = widget.blocks | default([]) %}

    {% if blocks | length > 0 %}
    {% if widget.data.layout == 'grid' %}
      {# Grid Layout #}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for block in blocks %}
          <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow">
            {# Quote Icon #}
            <div class="mb-4">
              <svg class="w-8 h-8 text-primary/30" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z"/>
              </svg>
            </div>

            {# Content #}
            <p class="text-theme-text-secondary text-sm leading-relaxed mb-5">{{ block.settings.content }}</p>

            {# Star Rating #}
            {% set rating = block.settings.rating | default('5') | int %}
            <div class="flex items-center gap-0.5 mb-4">
              {% for i in range(1, 6) %}
                <svg class="w-4 h-4 {% if i <= rating %}text-amber-400{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              {% endfor %}
            </div>

            {# Author Info #}
            <div class="flex items-center gap-3">
              {% if block.settings.author_image %}
                <img src="{{ block.settings.author_image }}" alt="{{ block.settings.author_name }}" class="w-10 h-10 rounded-full object-cover">
              {% else %}
                <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                  {{ block.settings.author_name[0] | upper }}
                </div>
              {% endif %}
              <div>
                <h4 class="text-sm font-bold text-theme-text">{{ block.settings.author_name }}</h4>
                {% if block.settings.author_title %}
                  <p class="text-xs text-theme-text-secondary/70">{{ block.settings.author_title }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

    {% else %}
      {# Slider Layout #}
      <div class="swiper" x-data x-init="$nextTick(() => {
        var slideCount = $el.querySelectorAll('.swiper-slide').length;
        new Swiper($el, {
          slidesPerView: 1,
          spaceBetween: 24,
          loop: slideCount > 3,
          {% if widget.data.autoplay %}
          autoplay: {
            delay: 5000,
            disableOnInteraction: false
          },
          {% endif %}
          pagination: {
            el: $el.querySelector('.swiper-pagination'),
            clickable: true
          },
          breakpoints: {
            768: { slidesPerView: 2 },
            1024: { slidesPerView: 3 }
          }
        });
      })">
        <div class="swiper-wrapper">
          {% for block in blocks %}
            <div class="swiper-slide">
              <div class="bg-white rounded-2xl p-6 shadow-sm h-full">
                {# Quote Icon #}
                <div class="mb-4">
                  <svg class="w-8 h-8 text-primary/30" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z"/>
                  </svg>
                </div>

                {# Content #}
                <p class="text-theme-text-secondary text-sm leading-relaxed mb-5">{{ block.settings.content }}</p>

                {# Star Rating #}
                {% set rating = block.settings.rating | default('5') | int %}
                <div class="flex items-center gap-0.5 mb-4">
                  {% for i in range(1, 6) %}
                    <svg class="w-4 h-4 {% if i <= rating %}text-amber-400{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% endfor %}
                </div>

                {# Author Info #}
                <div class="flex items-center gap-3">
                  {% if block.settings.author_image %}
                    <img src="{{ block.settings.author_image }}" alt="{{ block.settings.author_name }}" class="w-10 h-10 rounded-full object-cover">
                  {% else %}
                    <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                      {{ block.settings.author_name[0] | upper }}
                    </div>
                  {% endif %}
                  <div>
                    <h4 class="text-sm font-bold text-theme-text">{{ block.settings.author_name }}</h4>
                    {% if block.settings.author_title %}
                      <p class="text-xs text-theme-text-secondary/70">{{ block.settings.author_title }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {# Pagination #}
        <div class="swiper-pagination mt-6"></div>
      </div>
    {% endif %}
    {% else %}
      {# Preview / Empty State #}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for i in range(0, 3) %}
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-dashed border-theme-border">
            {# Quote Icon #}
            <div class="mb-4">
              <svg class="w-8 h-8 text-primary/15" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z"/>
              </svg>
            </div>
            {# Skeleton Content #}
            <div class="space-y-2 mb-5">
              <div class="h-3 bg-surface rounded-full w-full"></div>
              <div class="h-3 bg-surface rounded-full w-full"></div>
              <div class="h-3 bg-surface rounded-full w-2/3"></div>
            </div>
            {# Skeleton Stars #}
            <div class="flex items-center gap-0.5 mb-4">
              {% for s in range(5) %}
                <div class="w-4 h-4 rounded-sm bg-surface"></div>
              {% endfor %}
            </div>
            {# Skeleton Author #}
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-surface"></div>
              <div>
                <div class="h-3.5 w-24 bg-surface rounded-full mb-1.5"></div>
                <div class="h-3 w-16 bg-surface/60 rounded-full"></div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <p class="text-center text-sm text-theme-text-secondary/70 mt-8">{{t('testimonials.add_testimonials_hint')}}</p>
    {% endif %}
  </div>
</section>
