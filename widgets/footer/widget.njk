<footer style="background-color: {{ widget.data.background_color | default('#1a1a2e') }};" class="text-white">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      {# Logo & Description #}
      <div class="lg:col-span-1">
        {% if widget.data.show_logo %}
          <a href="/" class="inline-block mb-4">
            {% if store.logo.fileUrl %}
              <img src="{{ store.logo.fileUrl }}" alt="{{ store.name }}" class="h-10">
            {% else %}
              <span class="text-2xl font-bold">{{ store.name }}</span>
            {% endif %}
          </a>
        {% endif %}

        {% if widget.data.description %}
          <p class="text-white/60 text-sm leading-relaxed mb-4">
            {{ widget.data.description | safe }}
          </p>
        {% endif %}

        {# Phone Number #}
        {% if widget.data.phone_number %}
          <a href="tel:{{ widget.data.phone_number }}" dir="ltr" class="flex items-center gap-2 mt-4 text-white/60 hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            <span class="text-sm">{{ widget.data.phone_number }}</span>
          </a>
        {% endif %}

        {# Social Links #}
        {% if widget.data.show_social %}
          <div class="flex items-center gap-2 flex-wrap mt-4">
            {% if widget.data.instagram_url %}
              <a href="{{ widget.data.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.facebook_url %}
              <a href="{{ widget.data.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-[#1877F2] transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.twitter_url %}
              <a href="{{ widget.data.twitter_url }}" target="_blank" rel="noopener" aria-label="X" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.tiktok_url %}
              <a href="{{ widget.data.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.youtube_url %}
              <a href="{{ widget.data.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-[#FF0000] transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.linkedin_url %}
              <a href="{{ widget.data.linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-[#0A66C2] transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.snapchat_url %}
              <a href="{{ widget.data.snapchat_url }}" target="_blank" rel="noopener" aria-label="Snapchat" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-[#FFFC00] hover:text-black transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.12 1.033-.301.165-.088.344-.104.464-.104.182 0 .359.029.509.09.45.149.734.479.734.838.015.449-.39.839-1.213 1.168-.089.029-.209.075-.344.119-.45.135-1.139.36-1.333.81-.09.195-.045.42.044.6.046.074.09.148.135.193.315.39.704.874 1.018 1.289.195.254.495.734.39 1.199-.135.584-.75 1.02-1.36 1.079-.375.03-.675-.074-1.053-.195-.24-.074-.494-.164-.809-.164-.119 0-.239.015-.359.044-.435.104-.659.449-.896.765-.285.375-.614.808-1.259 1.02-.375.119-.78.164-1.304.164-.255 0-.494-.015-.749-.045-.898-.09-1.499-.585-2.099-1.08-.465-.384-.93-.764-1.499-.884-.256-.06-.509-.089-.749-.089-.434 0-.839.074-1.199.179-.195.074-.405.164-.614.254-.45.165-.885.329-1.229.329-.03 0-.06 0-.089-.015-.494-.06-1.034-.42-1.214-.93-.12-.36-.015-.75.254-1.139.359-.465.674-.869.964-1.274.06-.104.135-.209.195-.314.12-.195.149-.39.09-.585-.18-.42-.735-.644-1.184-.78a7.619 7.619 0 01-.39-.134C.641 12.566.15 12.221.015 11.821c-.09-.254-.045-.479.015-.614.1-.254.344-.479.674-.614.195-.074.419-.104.584-.104.225 0 .42.045.555.12.37.165.72.285 1.019.285.195 0 .329-.045.404-.09a16.86 16.86 0 01-.03-.509l-.002-.06c-.104-1.628-.23-3.654.299-4.848C5.447 1.069 8.844.793 9.834.793h2.372z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.telegram_url %}
              <a href="{{ widget.data.telegram_url }}" target="_blank" rel="noopener" aria-label="Telegram" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-[#26A5E4] transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              </a>
            {% endif %}
            {% if widget.data.whatsapp_number %}
              <a href="https://wa.me/{{ widget.data.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp" class="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center hover:bg-[#25D366] transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {# Menu 1 #}
      <div>
        <h3 class="text-base font-bold mb-4">{{ widget.data.menu_1_title }}</h3>
        <ul class="space-y-2">
          {% for item in widget.data.footer_menu_1 %}
            <li>
              <a href="{{ item.url | default('#') }}" class="text-white/60 hover:text-white text-sm transition-colors">
                {{ item.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      {# Menu 2 #}
      <div>
        <h3 class="text-base font-bold mb-4">{{ widget.data.menu_2_title }}</h3>
        <ul class="space-y-2">
          {% for item in widget.data.footer_menu_2 %}
            <li>
              <a href="{{ item.url | default('#') }}" class="text-white/60 hover:text-white text-sm transition-colors">
                {{ item.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      {# Newsletter #}
      <div>
        <h3 class="text-base font-bold mb-4">{{ t('footer.newsletter_title_f') if settings.addressingTone == 'feminine' else t('footer.newsletter_title') }}</h3>
        <p class="text-white/60 text-sm mb-3">{{ t('footer.newsletter_subtitle_f') if settings.addressingTone == 'feminine' else t('footer.newsletter_subtitle') }}</p>
        {% form "newsletter" %}
          <div class="flex gap-2">
            <input type="email" name="email"
                   class="flex-1 bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-sm text-white placeholder-white/50 focus:outline-none focus:border-primary"
                   placeholder="{{ t('footer.newsletter_placeholder_f') if settings.addressingTone == 'feminine' else t('footer.newsletter_placeholder') }}" required>
            <button type="submit" class="bg-primary hover:bg-primary-dark text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
              {{t('footer.newsletter_button')}}
            </button>
          </div>
        {% endform %}
      </div>
    </div>

    {# Copyright #}
    <div class="border-t border-white/10 mt-8 pt-6 text-center">
      <p class="text-white/50 text-sm">
        &copy; {{ "now" | date("YYYY") }} {{ store.name }}. {{ widget.data.copyright_text }}
      </p>
    </div>
  </div>
</footer>
