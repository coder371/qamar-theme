{# Products Grid Widget - Re-renderable section (products ONLY) #}
{# Server renders this independently when ?widgetKey=products-grid is requested #}
{# Filters/sidebar are OUTSIDE this section — SDK handles their state client-side #}

{% set shop = context.shop %}
{% set products = shop.products if shop and shop.products else [] %}
{% set pagination = shop.pagination if shop and shop.pagination else false %}
{% set shopCollection = shop.collection if shop and shop.collection else false %}
{% set searchQuery = shop.query if shop and shop.query else '' %}
{% set mode = shop.mode if shop and shop.mode else 'all' %}

{# Card display settings #}
{% set _cs_rating = widget.data.card_show_rating if widget.data.card_show_rating is defined else true %}
{% set _cs_options = widget.data.card_show_options if widget.data.card_show_options is defined else true %}
{% set _cs_badge = widget.data.card_show_badge if widget.data.card_show_badge is defined else true %}
{% set _cs_button = widget.data.card_show_button if widget.data.card_show_button is defined else true %}
{% set _cs_compare = widget.data.card_show_compare_price if widget.data.card_show_compare_price is defined else true %}
{% set _cs_wishlist = widget.data.card_show_wishlist | default(false) %}
{% set _cs_ratio = widget.data.card_image_ratio | default('square') %}
{% set _cs_lines = widget.data.card_title_lines | default('2') %}
{% set _cs_fit = widget.data.card_image_fit | default('contain') %}
{% set _cs_hover = widget.data.card_hover_effect | default('zoom') %}
{% set _cs_radius = widget.data.card_border_radius | default('lg') %}
{% set columns_desktop = widget.data.columns_desktop | default('3') %}

{# Sidebar presence (for grid columns) #}
{% set show_filters = widget.data.show_filters if widget.data.show_filters is defined else true %}
{% set hasFilters = show_filters and shop and shop.filters and shop.filters.available | length > 0 %}
{% set hasSidebar = hasFilters or (widget.data.show_sort if widget.data.show_sort is defined else true) %}

{# Products Count #}
<div class="flex items-center justify-between mb-4">
  <p class="text-sm text-theme-text-secondary">
    {% if mode == 'search' %}
      {{t('search.results_for')}}
      <span class="font-bold text-primary">"{{ searchQuery }}"</span>
      {% if pagination %}
        <span class="text-xs text-theme-text-secondary/70 ms-1">({{ pagination.totalItems }} {{t('common.products')}})</span>
      {% endif %}
    {% else %}
      <span class="font-bold text-theme-text">{% if pagination %}{{ pagination.totalItems }}{% else %}{{ products | length }}{% endif %}</span>
      {{t('common.products')}}
    {% endif %}
  </p>
</div>

{% if products | length > 0 %}
  <div class="grid grid-cols-2 gap-3 md:gap-5
    {% if hasSidebar %}
      md:grid-cols-2 lg:grid-cols-3
    {% else %}
      {% if columns_desktop == '3' %} md:grid-cols-3
      {% else %} md:grid-cols-4
      {% endif %}
    {% endif %}">
    {% for product in products %}
      {% ui "product-card.njk", product=product, show_rating=_cs_rating, show_options=_cs_options, show_badge=_cs_badge, image_ratio=_cs_ratio, show_button=_cs_button, show_compare_price=_cs_compare, title_lines=_cs_lines, image_fit=_cs_fit, hover_effect=_cs_hover, show_wishlist=_cs_wishlist, border_radius=_cs_radius %}
    {% endfor %}
  </div>

  {# Pagination #}
  {% if pagination and pagination.totalPages > 1 %}
    <nav class="flex items-center justify-center gap-1.5 mt-10" aria-label="pagination">
      {% if pagination.currentPage > 1 %}
        <button onclick="shopGoToPage({{ pagination.currentPage - 1 }})"
           class="w-10 h-10 rounded-xl flex items-center justify-center text-theme-text-secondary hover:bg-surface hover:text-primary transition-colors">
          <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
      {% else %}
        <span class="w-10 h-10 rounded-xl flex items-center justify-center text-gray-200">
          <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </span>
      {% endif %}

      {% for i in range(1, pagination.totalPages + 1) %}
        {% if i == pagination.currentPage %}
          <span class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary text-white font-semibold text-sm">{{ i }}</span>
        {% elif i == 1 or i == pagination.totalPages or (i >= pagination.currentPage - 1 and i <= pagination.currentPage + 1) %}
          <button onclick="shopGoToPage({{ i }})"
             class="w-10 h-10 rounded-xl flex items-center justify-center text-theme-text-secondary hover:bg-surface hover:text-primary transition-colors text-sm font-medium">{{ i }}</button>
        {% elif i == pagination.currentPage - 2 or i == pagination.currentPage + 2 %}
          <span class="w-6 flex items-center justify-center text-gray-300 text-sm">...</span>
        {% endif %}
      {% endfor %}

      {% if pagination.hasNextPage %}
        <button onclick="shopGoToPage({{ pagination.currentPage + 1 }})"
           class="w-10 h-10 rounded-xl flex items-center justify-center text-theme-text-secondary hover:bg-surface hover:text-primary transition-colors">
          <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      {% else %}
        <span class="w-10 h-10 rounded-xl flex items-center justify-center text-gray-200">
          <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      {% endif %}
    </nav>
  {% endif %}

{% else %}
  {# Empty State #}
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <div class="w-24 h-24 rounded-full bg-surface flex items-center justify-center mb-5">
      {% if mode == 'search' %}
        <svg class="w-12 h-12 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      {% else %}
        <svg class="w-12 h-12 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      {% endif %}
    </div>
    {% if mode == 'search' %}
      <h3 class="text-lg font-bold text-theme-text mb-2">{{t('search.no_results')}} "{{ searchQuery }}"</h3>
      <p class="text-theme-text-secondary text-sm mb-6">{{ t('search.try_different_f') if settings.addressingTone == 'feminine' else t('search.try_different') }}</p>
    {% else %}
      <h3 class="text-lg font-bold text-theme-text mb-2">{{t('collection.no_products')}}</h3>
      <p class="text-theme-text-secondary text-sm mb-6">{{t('common.no_results')}}</p>
    {% endif %}
    {% if shopCollection and mode == 'search' %}
      <a href="/shop/{{ shopCollection.handle }}" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:opacity-80 transition-colors">
        {{ shopCollection.title }}
        <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    {% else %}
      <a href="/shop" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:opacity-80 transition-colors">
        {{t('common.products')}}
        <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    {% endif %}
  </div>
{% endif %}
