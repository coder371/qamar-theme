{% set product = data.product %}
{% set hasDiscount = product.pricing.compareAtPrice and product.pricing.compareAtPrice > product.pricing.price %}
{% set canPurchase = product.quantity > 0 or not product.trackQuantity or product.allowBackorder %}

{# Card display settings with defaults #}
{% set showRating = data.show_rating if data.show_rating is defined else true %}
{% set showOptions = data.show_options if data.show_options is defined else true %}
{% set showBadge = data.show_badge if data.show_badge is defined else true %}
{% set imageRatio = data.image_ratio | default('square') %}
{% set showButton = data.show_button if data.show_button is defined else true %}
{% set showComparePrice = data.show_compare_price if data.show_compare_price is defined else true %}
{% set titleLines = data.title_lines | default('2') %}
{% set imageFit = data.image_fit | default('contain') %}
{% set hoverEffect = data.hover_effect | default('zoom') %}
{% set showWishlist = data.show_wishlist if data.show_wishlist is defined else false %}
{% set borderRadius = data.border_radius | default('lg') %}

{# Border radius mapping #}
{% if borderRadius == 'none' %}
  {% set radiusValue = '0' %}
{% elif borderRadius == 'sm' %}
  {% set radiusValue = '8px' %}
{% elif borderRadius == 'md' %}
  {% set radiusValue = '12px' %}
{% else %}
  {% set radiusValue = '16px' %}
{% endif %}

<div class="product-card group flex flex-col h-full {% if hoverEffect == 'zoom' %}hover-zoom{% endif %}"
     style="border-radius: {{ radiusValue }};"
     x-data="productCard('{{ product._id }}')">

  {# ===== Image ===== #}
  <a href="/product/{{ product.slug }}" class="block relative overflow-hidden card-img">
    <div class="{% if imageRatio == 'portrait' %}aspect-[3/4]{% elif imageRatio == 'landscape' %}aspect-[4/3]{% else %}aspect-square{% endif %} bg-white flex items-center justify-center {% if imageFit == 'contain' %}p-4{% endif %}">
      {% if product.images | length %}
        <img src="{{ product.images[0].fileUrl }}"
             alt="{{ product.title }}"
             class="{% if imageFit == 'contain' %}max-w-full max-h-full object-contain{% else %}w-full h-full object-cover{% endif %}"
             loading="lazy">
      {% else %}
        <svg class="w-16 h-16 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      {% endif %}
    </div>

    {# Discount Badge #}
    {% if showBadge and hasDiscount %}
      {% set discountPercent = (((product.pricing.compareAtPrice - product.pricing.price) / product.pricing.compareAtPrice) * 100) | round %}
      <span class="absolute top-2.5 start-2.5 bg-red-500 text-white text-[11px] font-semibold px-2 py-0.5 rounded">
        -{{ discountPercent }}%
      </span>
    {% endif %}

    {# Wishlist Button #}
    {% if showWishlist %}
      <button @click.prevent="toggleWishlist()"
              :disabled="wishlistLoading"
              class="wishlist-btn absolute top-2.5 end-2.5 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-sm transition-all hover:scale-110"
              :class="inWishlist ? 'text-red-500' : 'text-gray-400 hover:text-red-400'">
        <svg class="w-4 h-4" :fill="inWishlist ? 'currentColor' : 'none'" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </button>
    {% endif %}
  </a>

  {# ===== Content ===== #}
  <div class="p-3 pt-2 flex flex-col flex-1">

    {# Title #}
    <a href="/product/{{ product.slug }}" class="block text-sm font-medium text-gray-900 {% if titleLines == '1' %}line-clamp-1{% else %}line-clamp-2{% endif %} leading-snug mb-2 hover:text-primary transition-colors">
      {{ product.title }}
    </a>

    {# Rating #}
    {% if showRating and product.averageRating > 0 %}
      <div class="flex items-center gap-0.5 mb-2">
        {% for i in range(5) %}
          <svg class="w-3.5 h-3.5 {% if i < product.averageRating %}text-amber-400{% else %}text-gray-200{% endif %}" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        {% endfor %}
        <span class="text-[11px] text-gray-400 ms-1">({{ product.reviewsCount }})</span>
      </div>
    {% endif %}

    {# Color Swatches Only #}
    {% if showOptions %}
      {% for option in product.options %}
        {% if option.type == 'color' and option.values | length > 0 %}
          <div class="flex items-center gap-1.5 mb-2">
            {% for value in option.values %}
              <span class="w-4 h-4 rounded-full border border-gray-300 shrink-0"
                    style="background-color: {{ value.value | default('#ffffff') }};"
                    title="{{ value.label }}"></span>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    {# Price (pushed to bottom) #}
    <div class="mt-auto">
      <div class="flex items-baseline gap-2 {% if showButton %}mb-2.5{% endif %}">
        <span class="text-base font-bold text-gray-900">{{ product.pricing.price | money }}</span>
        {% if showComparePrice and hasDiscount %}
          <span class="text-xs text-gray-400 line-through">{{ product.pricing.compareAtPrice | money }}</span>
        {% endif %}
      </div>

      {# Button #}
      {% if showButton %}
        {% if canPurchase %}
          {% if product.variantsCount > 0 %}
            <a href="/product/{{ product.slug }}"
               class="flex items-center justify-center gap-1.5 w-full py-2.5 rounded-lg text-xs font-semibold border-2 border-primary text-primary hover:bg-primary hover:text-white transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              {{t('product.choose_options')}}
            </a>
          {% else %}
            <button @click="addToCart()"
                    :disabled="cartLoading || cartSuccess"
                    class="flex items-center justify-center gap-1.5 w-full py-2.5 rounded-lg text-xs font-semibold transition-all"
                    :class="cartSuccess
                      ? 'bg-green-500 text-white border-2 border-green-500'
                      : 'bg-primary text-white border-2 border-primary hover:bg-primary-dark hover:border-primary-dark'">
              <template x-if="cartLoading">
                <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </template>
              <template x-if="cartSuccess">
                <svg class="w-4 h-4 animate-check" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </template>
              <template x-if="!cartLoading && !cartSuccess">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                </svg>
              </template>
              <span x-show="!cartLoading && !cartSuccess">{{t('product.add_to_cart')}}</span>
              <span x-show="cartSuccess" x-cloak>{{t('product.added')}}</span>
            </button>
          {% endif %}
        {% else %}
          <div class="text-center py-2 text-xs text-gray-400 font-medium">
            {{t('product.out_of_stock')}}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>
