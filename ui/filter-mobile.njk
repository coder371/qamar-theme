{# Mobile Filter & Sort — Pure Alpine state → SDK apply() #}
{# No SDK calls until "Show Results" is pressed. Alpine is the source of truth. #}

{% set _appliedFilters = appliedFilters | default({}) %}

{% if hasSidebar %}
  <div class="md:hidden mb-5"
       x-data="{
         filtersOpen: false,
         sortOpen: false,
         sort: '{{ currentSort }}',
         groupOpen: { {% for f in filters %}'{{ f.handle }}': true{% if not loop.last %}, {% endif %}{% endfor %} },
         sel: { {% for f in filters %}{% if f.inputType == 'select' %}'{{ f.handle }}': []{% if not loop.last %}, {% endif %}{% endif %}{% endfor %} },
         rng: { {% for f in filters %}{% if f.inputType == 'range' %}'{{ f.handle }}': { min: '', max: '' }{% if not loop.last %}, {% endif %}{% endif %}{% endfor %} },
         srch: { {% for f in filters %}{% if f.inputType == 'search_text' %}'{{ f.handle }}': ''{% if not loop.last %}, {% endif %}{% endif %}{% endfor %} },

         syncAll() {
           var p = new URLSearchParams(location.search);
           var self = this;
           Object.keys(this.sel).forEach(function(h) {
             self.sel[h] = p.getAll('filters[' + h + '][]');
           });
           Object.keys(this.rng).forEach(function(h) {
             var min = p.get('filters[' + h + '][min]');
             var max = p.get('filters[' + h + '][max]');
             self.rng[h] = { min: min || '', max: max || '' };
           });
           Object.keys(this.srch).forEach(function(h) {
             var v = p.getAll('filters[' + h + '][]')[0];
             self.srch[h] = v || '';
           });
         },
         toggle(h, v) {
           if (!this.sel[h]) this.sel[h] = [];
           var i = this.sel[h].indexOf(v);
           if (i === -1) this.sel[h] = this.sel[h].concat([v]);
           else this.sel[h] = this.sel[h].filter(function(x) { return x !== v; });
         },
         has(h, v) { return this.sel[h] && this.sel[h].indexOf(v) !== -1; },
         countFor(h) { return this.sel[h] ? this.sel[h].length : 0; },
         clearHandle(h) { this.sel[h] = []; },
         hasRng(h) { return this.rng[h] && (this.rng[h].min !== '' || this.rng[h].max !== ''); },
         clearRng(h) { this.rng[h] = { min: '', max: '' }; },
         clearAll() {
           var self = this;
           Object.keys(this.sel).forEach(function(h) { self.sel[h] = []; });
           Object.keys(this.rng).forEach(function(h) { self.rng[h] = { min: '', max: '' }; });
           Object.keys(this.srch).forEach(function(h) { self.srch[h] = ''; });
           qumra.filters.clear();
           this.filtersOpen = false;
         },
         applyFilters() {
           var state = {};
           var self = this;
           Object.keys(this.sel).forEach(function(h) {
             if (self.sel[h].length > 0) state[h] = self.sel[h].slice();
           });
           Object.keys(this.rng).forEach(function(h) {
             var r = self.rng[h];
             if (r.min !== '' || r.max !== '') {
               state[h] = {};
               if (r.min !== '') state[h].min = +r.min;
               if (r.max !== '') state[h].max = +r.max;
             }
           });
           Object.keys(this.srch).forEach(function(h) {
             if (self.srch[h]) state[h] = [self.srch[h]];
           });
           var opts = {};
           try { var s = qumra.filters.getSort(); if (s) opts.sort = s; } catch(e) {}
           try { var q = qumra.filters.getQuery(); if (q) opts.q = q; } catch(e) {}
           qumra.filters.apply(state, opts);
           this.filtersOpen = false;
         }
       }"
       x-init="syncAll()"
       x-effect="document.body.style.overflow = (filtersOpen || sortOpen) ? 'hidden' : ''"
       @close-mobile-filters.window="filtersOpen = false"
       @filters-synced.window="if (!filtersOpen) syncAll()">

    {# ===== Toolbar ===== #}
    <div class="flex items-center gap-3">
      {% if hasFilters %}
        <button @click="syncAll(); filtersOpen = true"
                class="flex-1 flex items-center justify-center gap-2 text-sm border border-theme-border rounded-xl px-4 py-2.5 bg-white active:bg-gray-50 transition-colors">
          <svg class="w-4 h-4 text-theme-text-secondary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
          </svg>
          <span>{{t('collection.filter')}}</span>
          <span x-data="{ n: 0 }"
                x-init="if (window.qumra) n = qumra.filters.count()"
                @filters-synced.window="$nextTick(() => { if (window.qumra) n = qumra.filters.count() })"
                x-show="n > 0" x-text="n" x-cloak
                class="bg-primary text-white text-[10px] font-bold min-w-[20px] h-5 rounded-full flex items-center justify-center px-1"></span>
        </button>
      {% endif %}
      {% if show_sort %}
        <button @click="sortOpen = true"
                class="flex-1 flex items-center justify-center gap-2 text-sm border border-theme-border rounded-xl px-4 py-2.5 bg-white active:bg-gray-50 transition-colors">
          <svg class="w-4 h-4 text-theme-text-secondary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
          </svg>
          <span>{{t('collection.sort')}}</span>
        </button>
      {% endif %}
    </div>

    {# ===== Sort Bottom Sheet ===== #}
    {% if show_sort %}
      <div x-show="sortOpen" x-cloak class="fixed inset-0 z-50 md:hidden" @keydown.escape.window="sortOpen = false">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]" @click="sortOpen = false"
             x-show="sortOpen"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
        </div>
        <div class="absolute bottom-0 inset-x-0 bg-white rounded-t-[28px] max-h-[80vh] overflow-y-auto"
             x-show="sortOpen"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="translate-y-full" x-transition:enter-end="translate-y-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="translate-y-0" x-transition:leave-end="translate-y-full">
          <div class="flex justify-center pt-3 pb-1">
            <div class="w-10 h-1 bg-gray-200 rounded-full"></div>
          </div>
          <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
            <h3 class="font-bold text-theme-text text-base">{{t('collection.sort')}}</h3>
            <button @click="sortOpen = false" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="p-4 space-y-1">
            {% set sortOptions = [
              { value: '', label: "collection.all_products" },
              { value: 'createdAt-desc', label: "search.newest" },
              { value: 'price-asc', label: "search.price_low_high" },
              { value: 'price-desc', label: "search.price_high_low" }
            ] %}
            {% for opt in sortOptions %}
              <button @click="sort = '{{ opt.value }}'; qumra.filters.sort('{{ opt.value }}'); sortOpen = false"
                      class="w-full text-start px-4 py-3 text-sm rounded-xl transition-all flex items-center justify-between"
                      :class="sort === '{{ opt.value }}' ? 'bg-primary/10 text-primary font-semibold' : 'text-theme-text-secondary hover:bg-gray-50'">
                <span>{{t(opt.label)}}</span>
                <svg x-show="sort === '{{ opt.value }}'" x-cloak class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </button>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}

    {# ===== Filters Bottom Sheet ===== #}
    {% if hasFilters %}
      <div x-show="filtersOpen" x-cloak class="fixed inset-0 z-50 md:hidden" @keydown.escape.window="filtersOpen = false">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]" @click="filtersOpen = false"
             x-show="filtersOpen"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0">
        </div>

        <div class="absolute bottom-0 inset-x-0 bg-white rounded-t-[28px] max-h-[92vh] flex flex-col"
             x-show="filtersOpen"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="translate-y-full" x-transition:enter-end="translate-y-0"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="translate-y-0" x-transition:leave-end="translate-y-full">

          <div class="flex justify-center pt-3 pb-1">
            <div class="w-10 h-1 bg-gray-200 rounded-full"></div>
          </div>

          {# Header #}
          <div class="flex items-center justify-between px-5 py-3 border-b border-gray-100">
            <h3 class="font-bold text-theme-text text-base">{{t('collection.filter')}}</h3>
            <div class="flex items-center gap-3">
              <button x-data="{ show: false }"
                      x-init="if (window.qumra) show = qumra.filters.hasAny()"
                      @filters-synced.window="$nextTick(() => { if (window.qumra) show = qumra.filters.hasAny() })"
                      x-show="show" x-cloak
                      @click="clearAll()"
                      class="text-xs text-red-500 font-semibold px-2 py-1 rounded-lg active:bg-red-50 transition-colors">
                {{t('collection.clear_filters')}}
              </button>
              <button @click="filtersOpen = false"
                      class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center active:bg-gray-200 transition-colors">
                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
          </div>

          {# Filter Groups #}
          <div class="overflow-y-auto flex-1 overscroll-contain">
            {% for filter in filters %}
              {% set _applied = _appliedFilters[filter.handle] %}

              {# ── Range Filter — Alpine state only, NO SDK call ── #}
              {% if filter.inputType == 'range' %}
                <div class="px-5 py-4 {% if not loop.last %}border-b border-gray-100{% endif %}">
                  <button @click="groupOpen['{{ filter.handle }}'] = !groupOpen['{{ filter.handle }}']" class="flex items-center justify-between w-full mb-1">
                    <div class="flex items-center gap-2">
                      <h4 class="text-sm font-semibold text-theme-text">
                        {{ filter.name[localization.language] | default(filter.name.ar) }}
                      </h4>
                      <span x-show="hasRng('{{ filter.handle }}')" x-cloak class="w-2 h-2 bg-primary rounded-full"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span x-show="hasRng('{{ filter.handle }}')" x-cloak
                            @click.stop="clearRng('{{ filter.handle }}')"
                            class="text-[10px] text-red-500 font-semibold cursor-pointer">
                        {{t('collection.clear_filters')}}
                      </span>
                      <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" :class="groupOpen['{{ filter.handle }}'] && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                  </button>
                  <div x-show="groupOpen['{{ filter.handle }}']"
                       x-transition:enter="transition ease-out duration-200"
                       x-transition:enter-start="opacity-0 -translate-y-1"
                       x-transition:enter-end="opacity-100 translate-y-0"
                       class="pt-3">
                    <div dir="ltr" class="transition-opacity duration-300" :class="hasRng('{{ filter.handle }}') ? 'opacity-100' : 'opacity-40'">
                      <div class="flex items-center justify-between mb-4">
                        <span class="text-xs font-semibold bg-gray-50 text-theme-text px-3 py-1.5 rounded-lg tabular-nums"
                              x-text="(+(rng['{{ filter.handle }}'].min) || {{ filter.range.min }}).toLocaleString()"></span>
                        <span class="text-xs text-gray-300">—</span>
                        <span class="text-xs font-semibold bg-gray-50 text-theme-text px-3 py-1.5 rounded-lg tabular-nums"
                              x-text="(+(rng['{{ filter.handle }}'].max) || {{ filter.range.max }}).toLocaleString()"></span>
                      </div>
                      <div class="price-slider">
                        <div class="slider-track"></div>
                        <div class="slider-range"
                             :style="`left: ${((+(rng['{{ filter.handle }}'].min) || {{ filter.range.min }}) - {{ filter.range.min }}) / ({{ filter.range.max }} - {{ filter.range.min }}) * 100}%; right: ${100 - ((+(rng['{{ filter.handle }}'].max) || {{ filter.range.max }}) - {{ filter.range.min }}) / ({{ filter.range.max }} - {{ filter.range.min }}) * 100}%`"></div>
                        <input type="range" min="{{ filter.range.min }}" max="{{ filter.range.max }}" step="{{ filter.range.step | default(1) }}"
                               :value="+(rng['{{ filter.handle }}'].min) || {{ filter.range.min }}"
                               @input="rng['{{ filter.handle }}'].min = '' + Math.min(+$event.target.value, +(rng['{{ filter.handle }}'].max) || {{ filter.range.max }}); $event.target.value = rng['{{ filter.handle }}'].min">
                        <input type="range" min="{{ filter.range.min }}" max="{{ filter.range.max }}" step="{{ filter.range.step | default(1) }}"
                               :value="+(rng['{{ filter.handle }}'].max) || {{ filter.range.max }}"
                               @input="rng['{{ filter.handle }}'].max = '' + Math.max(+$event.target.value, +(rng['{{ filter.handle }}'].min) || {{ filter.range.min }}); $event.target.value = rng['{{ filter.handle }}'].max">
                      </div>
                    </div>
                  </div>
                </div>

              {# ── Select Filter — Pure Alpine state ── #}
              {% elif filter.inputType == 'select' %}
                <div class="px-5 py-4 {% if not loop.last %}border-b border-gray-100{% endif %}">
                  <button @click="groupOpen['{{ filter.handle }}'] = !groupOpen['{{ filter.handle }}']" class="flex items-center justify-between w-full mb-1">
                    <div class="flex items-center gap-2">
                      <h4 class="text-sm font-semibold text-theme-text">
                        {{ filter.name[localization.language] | default(filter.name.ar) }}
                      </h4>
                      <span x-show="countFor('{{ filter.handle }}') > 0" x-cloak x-text="countFor('{{ filter.handle }}')"
                            class="text-[10px] bg-primary text-white min-w-[20px] h-5 rounded-full inline-flex items-center justify-center font-bold px-1"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span x-show="countFor('{{ filter.handle }}') > 0" x-cloak
                            @click.stop="clearHandle('{{ filter.handle }}')"
                            class="text-[10px] text-red-500 font-semibold cursor-pointer">
                        {{t('collection.clear_filters')}}
                      </span>
                      <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" :class="groupOpen['{{ filter.handle }}'] && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                  </button>
                  <div x-show="groupOpen['{{ filter.handle }}']"
                       x-transition:enter="transition ease-out duration-200"
                       x-transition:enter-start="opacity-0 -translate-y-1"
                       x-transition:enter-end="opacity-100 translate-y-0"
                       class="pt-2 space-y-0.5">
                    {% for item in filter.items %}
                      <div @click="toggle('{{ filter.handle }}', '{{ item.value }}')"
                           class="flex items-center gap-3 py-2.5 px-2 -mx-2 rounded-xl cursor-pointer active:bg-gray-50 transition-colors">
                        <div class="shrink-0 w-[22px] h-[22px] rounded-lg border-2 flex items-center justify-center transition-all duration-200"
                             :class="has('{{ filter.handle }}', '{{ item.value }}') ? 'bg-primary border-primary' : 'border-gray-200'">
                          <svg x-show="has('{{ filter.handle }}', '{{ item.value }}')" x-cloak
                               x-transition:enter="transition ease-out duration-150"
                               x-transition:enter-start="opacity-0 scale-50"
                               x-transition:enter-end="opacity-100 scale-100"
                               class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                          </svg>
                        </div>
                        <span class="text-sm transition-colors"
                              :class="has('{{ filter.handle }}', '{{ item.value }}') ? 'text-theme-text font-medium' : 'text-theme-text-secondary'">
                          {{ item.label[localization.language] | default(item.label.ar) | default(item.value) }}
                        </span>
                      </div>
                    {% endfor %}
                  </div>
                </div>

              {# ── Search Text Filter — Alpine state only, NO SDK call ── #}
              {% elif filter.inputType == 'search_text' %}
                <div class="px-5 py-4 {% if not loop.last %}border-b border-gray-100{% endif %}">
                  <button @click="groupOpen['{{ filter.handle }}'] = !groupOpen['{{ filter.handle }}']" class="flex items-center justify-between w-full mb-1">
                    <div class="flex items-center gap-2">
                      <h4 class="text-sm font-semibold text-theme-text">
                        {{ filter.name[localization.language] | default(filter.name.ar) }}
                      </h4>
                      <span x-show="srch['{{ filter.handle }}'].length > 0" x-cloak class="w-2 h-2 bg-primary rounded-full"></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <span x-show="srch['{{ filter.handle }}'].length > 0" x-cloak
                            @click.stop="srch['{{ filter.handle }}'] = ''"
                            class="text-[10px] text-red-500 font-semibold cursor-pointer">
                        {{t('collection.clear_filters')}}
                      </span>
                      <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" :class="groupOpen['{{ filter.handle }}'] && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                  </button>
                  <div x-show="groupOpen['{{ filter.handle }}']"
                       x-transition:enter="transition ease-out duration-200"
                       x-transition:enter-start="opacity-0 -translate-y-1"
                       x-transition:enter-end="opacity-100 translate-y-0"
                       class="pt-3">
                    <div class="relative">
                      <input type="text"
                             :value="srch['{{ filter.handle }}']"
                             @input="srch['{{ filter.handle }}'] = $event.target.value"
                             placeholder="{{t('common.search')}}..."
                             class="w-full border border-theme-border rounded-xl px-3 py-2.5 pe-9 text-sm focus:outline-none focus:border-primary transition-colors">
                      <svg class="w-4 h-4 text-theme-text-secondary/70 absolute end-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                      </svg>
                    </div>
                  </div>
                </div>
              {% endif %}

            {% endfor %}
          </div>

          {# Sticky Footer — Show Results #}
          <div class="sticky bottom-0 px-5 py-4 bg-white border-t border-gray-100 shadow-[0_-4px_20px_rgba(0,0,0,0.06)]">
            <button @click="applyFilters()"
                    class="w-full py-3 bg-primary text-white text-sm font-bold rounded-xl active:opacity-90 transition-opacity">
              {{t('collection.show_results')}}
            </button>
          </div>

        </div>
      </div>
    {% endif %}

  </div>
{% endif %}
