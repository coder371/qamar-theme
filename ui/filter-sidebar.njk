{# Shared Filter Sidebar (Desktop) - Uses FiltersModule SDK #}
{# Params: show_sort, filters, hasFilters, currentSort, appliedFilters #}
{# Auto-detected: data-qumra-filter + data-value (checkbox toggle), data-qumra-filter-clear #}
{# JS methods: qumra.filters.sort(), .range(), .searchText(), .remove() #}

{% set _appliedFilters = appliedFilters | default({}) %}

{# Sort Section — Alpine tracks active state client-side #}
{% if show_sort %}
  <div class="bg-white rounded-2xl border border-theme-border/40 p-5"
       x-data="{ sort: '{{ currentSort }}' }"
       @click="if ($event.target.closest('[data-sort]')) { sort = $event.target.closest('[data-sort]').dataset.sort; qumra.filters.sort(sort); }">
    <h3 class="font-semibold text-theme-text text-sm mb-3 flex items-center gap-2">
      <svg class="w-4 h-4 text-theme-text-secondary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
      </svg>
      {{t('collection.sort')}}
    </h3>
    <div class="space-y-1">
      <button data-sort=""
              class="w-full text-start px-3 py-2 text-sm rounded-lg transition-colors"
              :class="sort === '' ? 'bg-primary/10 text-primary font-medium' : 'text-theme-text-secondary hover:bg-surface'">
        {{t('collection.all_products')}}
      </button>
      <button data-sort="createdAt-desc"
              class="w-full text-start px-3 py-2 text-sm rounded-lg transition-colors"
              :class="sort === 'createdAt-desc' ? 'bg-primary/10 text-primary font-medium' : 'text-theme-text-secondary hover:bg-surface'">
        {{t('search.newest')}}
      </button>
      <button data-sort="price-asc"
              class="w-full text-start px-3 py-2 text-sm rounded-lg transition-colors"
              :class="sort === 'price-asc' ? 'bg-primary/10 text-primary font-medium' : 'text-theme-text-secondary hover:bg-surface'">
        {{t('search.price_low_high')}}
      </button>
      <button data-sort="price-desc"
              class="w-full text-start px-3 py-2 text-sm rounded-lg transition-colors"
              :class="sort === 'price-desc' ? 'bg-primary/10 text-primary font-medium' : 'text-theme-text-secondary hover:bg-surface'">
        {{t('search.price_high_low')}}
      </button>
    </div>
  </div>
{% endif %}

{# Filters Section #}
{% if hasFilters %}
  <div class="bg-white rounded-2xl border border-theme-border/40 p-5">
    <h3 class="font-semibold text-theme-text text-sm mb-4 flex items-center gap-2">
      <svg class="w-4 h-4 text-theme-text-secondary/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      {{t('collection.filter')}}
    </h3>
    <div class="space-y-4">
      {% for filter in filters %}
        {% set _applied = _appliedFilters[filter.handle] %}

        {# Range Filter — JS: qumra.filters.range(name, { min, max }) #}
        {% if filter.inputType == 'range' %}
          {% set _appliedMin = _applied.min | default('') if _applied else '' %}
          {% set _appliedMax = _applied.max | default('') if _applied else '' %}
          <div x-data="{ open: true, rMin: '{{ _appliedMin }}', rMax: '{{ _appliedMax }}', applied: {{ 'true' if _appliedMin or _appliedMax else 'false' }}, debounce: null }" x-init="
            const p = new URLSearchParams(location.search);
            const min = p.get('filters[{{ filter.handle }}][min]');
            const max = p.get('filters[{{ filter.handle }}][max]');
            if (min) { rMin = min; applied = true; }
            if (max) { rMax = max; applied = true; }
          ">
            <div class="flex items-center justify-between mb-2">
              <button @click="open = !open" class="flex items-center gap-1 text-sm font-medium text-theme-text">
                <span>{{ filter.name[localization.language] | default(filter.name.ar) }}</span>
                <svg class="w-3.5 h-3.5 text-theme-text-secondary/70 transition-transform" :class="open && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <button x-show="applied" x-cloak
                      @click="qumra.filters.remove('{{ filter.handle }}'); rMin = ''; rMax = ''; applied = false"
                      class="text-[10px] text-red-500 hover:text-red-600 font-medium">
                {{t('collection.clear_filters')}}
              </button>
            </div>
            <div x-show="open" x-cloak dir="ltr"
                 class="transition-opacity duration-300"
                 :class="applied ? 'opacity-100' : 'opacity-40'">
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-semibold bg-surface text-theme-text px-2.5 py-1 rounded-lg tabular-nums"
                      x-text="(+(rMin) || {{ filter.range.min }}).toLocaleString()"></span>
                <span class="text-xs text-theme-text-secondary/50">—</span>
                <span class="text-xs font-semibold bg-surface text-theme-text px-2.5 py-1 rounded-lg tabular-nums"
                      x-text="(+(rMax) || {{ filter.range.max }}).toLocaleString()"></span>
              </div>
              <div class="price-slider">
                <div class="slider-track"></div>
                <div class="slider-range"
                     :style="`left: ${((+(rMin) || {{ filter.range.min }}) - {{ filter.range.min }}) / ({{ filter.range.max }} - {{ filter.range.min }}) * 100}%; right: ${100 - ((+(rMax) || {{ filter.range.max }}) - {{ filter.range.min }}) / ({{ filter.range.max }} - {{ filter.range.min }}) * 100}%`"></div>
                <input type="range"
                       min="{{ filter.range.min }}" max="{{ filter.range.max }}" step="{{ filter.range.step | default(1) }}"
                       :value="+(rMin) || {{ filter.range.min }}"
                       @input="rMin = Math.min(+$event.target.value, +(rMax) || {{ filter.range.max }}); $event.target.value = rMin; applied = true; clearTimeout(debounce); debounce = setTimeout(() => qumra.filters.range('{{ filter.handle }}', { min: +rMin, max: +(rMax) || {{ filter.range.max }} }), 300)">
                <input type="range"
                       min="{{ filter.range.min }}" max="{{ filter.range.max }}" step="{{ filter.range.step | default(1) }}"
                       :value="+(rMax) || {{ filter.range.max }}"
                       @input="rMax = Math.max(+$event.target.value, +(rMin) || {{ filter.range.min }}); $event.target.value = rMax; applied = true; clearTimeout(debounce); debounce = setTimeout(() => qumra.filters.range('{{ filter.handle }}', { min: +(rMin) || {{ filter.range.min }}, max: +rMax }), 300)">
              </div>
            </div>
          </div>

        {# Select Filter — auto-detected: data-qumra-filter + data-value (zero JS) #}
        {% elif filter.inputType == 'select' %}
          {% set _appliedValues = _applied | default([]) %}
          <div x-data="{ open: true, active: false }" x-init="
            const vals = new URLSearchParams(location.search).getAll('filters[{{ filter.handle }}][]');
            if (vals.length) $el.querySelectorAll('input[data-qumra-filter]').forEach(cb => {
              if (vals.includes(cb.getAttribute('data-value'))) cb.checked = true;
            });
            active = !!$el.querySelector('input:checked');
          " @filters-synced.window="$nextTick(() => { active = !!$el.querySelector('input:checked') })">
            <div class="flex items-center justify-between mb-2">
              <button @click="open = !open" class="flex items-center gap-1 text-sm font-medium text-theme-text">
                <span>{{ filter.name[localization.language] | default(filter.name.ar) }}</span>
                <svg class="w-3.5 h-3.5 text-theme-text-secondary/70 transition-transform" :class="open && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <button x-show="active" x-cloak
                      @click="qumra.filters.remove('{{ filter.handle }}'); active = false; $el.closest('[x-data]').querySelectorAll('input[type=checkbox]').forEach(c => c.checked = false)"
                      class="text-[10px] text-red-500 hover:text-red-600 font-medium">
                {{t('collection.clear_filters')}}
              </button>
            </div>
            <div x-show="open" x-cloak class="space-y-1">
              {% for item in filter.items %}
                <label class="flex items-center gap-2.5 py-1 cursor-pointer group"
                       @click="$nextTick(() => { active = !!$el.closest('[x-data]').querySelector('input:checked') })">
                  <input type="checkbox"
                         data-qumra-filter="{{ filter.handle }}" data-value="{{ item.value }}"
                         {% if item.value in _appliedValues %}checked{% endif %}
                         class="w-4 h-4 rounded border-gray-300"
                         style="accent-color: var(--color-primary);">
                  <span class="text-sm text-theme-text-secondary group-hover:text-theme-text transition-colors">
                    {{ item.label[localization.language] | default(item.label.ar) | default(item.value) }}
                  </span>
                </label>
              {% endfor %}
            </div>
          </div>

        {# Search Text Filter — JS: qumra.filters.searchText(name, value) #}
        {% elif filter.inputType == 'search_text' %}
          {% set _appliedValue = _applied[0] | default('') if _applied else '' %}
          <div x-data="{ open: true, debounce: null, val: '{{ _appliedValue }}' }" x-init="
            const v = new URLSearchParams(location.search).getAll('filters[{{ filter.handle }}][]')[0];
            if (v) { val = v; $el.querySelector('input').value = v; }
          ">
            <div class="flex items-center justify-between mb-2">
              <button @click="open = !open" class="flex items-center gap-1 text-sm font-medium text-theme-text">
                <span>{{ filter.name[localization.language] | default(filter.name.ar) }}</span>
                <svg class="w-3.5 h-3.5 text-theme-text-secondary/70 transition-transform" :class="open && 'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <button x-show="val.length > 0" x-cloak
                      @click="qumra.filters.remove('{{ filter.handle }}'); val = ''; $el.closest('[x-data]').querySelector('input').value = ''"
                      class="text-[10px] text-red-500 hover:text-red-600 font-medium">
                {{t('collection.clear_filters')}}
              </button>
            </div>
            <div x-show="open" x-cloak>
              <div class="relative">
                <input type="text"
                       value="{{ _appliedValue }}"
                       @input="val = $event.target.value; clearTimeout(debounce); debounce = setTimeout(() => qumra.filters.searchText('{{ filter.handle }}', val), 500)"
                       placeholder="{{t('common.search')}}..."
                       class="w-full border border-theme-border rounded-lg px-3 py-2 pe-9 text-sm focus:outline-none focus:border-primary transition-colors">
                <svg class="w-4 h-4 text-theme-text-secondary/70 absolute end-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
            </div>
          </div>
        {% endif %}

        {% if not loop.last %}
          <div class="border-t border-theme-border/40"></div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}
